<Window x:Class="FpsOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MusicPlayer FPS Monitor" Height="68" Width="230"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="Manual"
        Left="40" Top="40" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border Background="#E610141D" CornerRadius="12" BorderBrush="#40FFFFFF" BorderThickness="1.5" Padding="12,8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#00E5FF" Margin="0,0,6,0"/>
                    <TextBlock Text="MUSICPLAYER FPS" Foreground="#88FFFFFF" FontSize="10" FontWeight="Bold"/>
                </StackPanel>
                <Button Content="✕" HorizontalAlignment="Right" Foreground="#88FFFFFF" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Close_Click" FontSize="11" Padding="4,0" ToolTip="Close FPS Overlay"/>
            </Grid>
            <Grid Grid.Row="1" Margin="0,2,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="FpsText" Text="-- FPS" FontSize="18" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="FrameTimeText" Text="-- ms" FontSize="12" Foreground="#D0FFFFFF" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="StatsText" Text="Waiting..." HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#88FFFFFF" FontSize="10"/>
            </Grid>
        </Grid>
    </Border>
</Window>
