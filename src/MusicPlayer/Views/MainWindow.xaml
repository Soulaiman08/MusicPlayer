                  </FrameworkElement.Style>
                  <UIElement.InputBindings>
                    <MouseBinding MouseAction="LeftClick" CommandParameter="2" Command="{Binding ToggleSoundEffectCommand}" />
                  </UIElement.InputBindings>
                  <StackPanel IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Tone Low" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFFFF" HorizontalAlignment="Center" />
                    <TextBlock Text="Car Bass &amp; Chamber Reverb" FontSize="11" Foreground="#99FFFFFF" HorizontalAlignment="Center" Margin="0,4,0,0" />
                  </StackPanel>
                </Border>
                <Border Margin="6" Padding="16,12" CornerRadius="12" Cursor="Hand" BorderThickness="1.5">
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type Border}">
                      <Setter Property="Background" Value="#1AFFFFFF" />
                      <Setter Property="BorderBrush" Value="#22FFFFFF" />
                      <Style.Triggers>
                        <DataTrigger Value="3" Binding="{Binding CurrentSoundEffect}">
                          <Setter Property="Background" Value="#333B82F6" />
                          <Setter Property="BorderBrush" Value="#FF3B82F6" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                  <UIElement.InputBindings>
                    <MouseBinding MouseAction="LeftClick" CommandParameter="3" Command="{Binding ToggleSoundEffectCommand}" />
                  </UIElement.InputBindings>
                  <StackPanel IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Surround" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFFFF" HorizontalAlignment="Center" />
                    <TextBlock Text="Stereo field widening" FontSize="11" Foreground="#99FFFFFF" HorizontalAlignment="Center" Margin="0,4,0,0" />
                  </StackPanel>
                </Border>
                <Border Margin="6" Padding="16,12" CornerRadius="12" Cursor="Hand" BorderThickness="1.5">
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type Border}">
                      <Setter Property="Background" Value="#1AFFFFFF" />
                      <Setter Property="BorderBrush" Value="#22FFFFFF" />
                      <Style.Triggers>
                        <DataTrigger Value="4" Binding="{Binding CurrentSoundEffect}">
                          <Setter Property="Background" Value="#333B82F6" />
                          <Setter Property="BorderBrush" Value="#FF3B82F6" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                  <UIElement.InputBindings>
                    <MouseBinding MouseAction="LeftClick" CommandParameter="4" Command="{Binding ToggleSoundEffectCommand}" />
                  </UIElement.InputBindings>
                  <StackPanel IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Magic Sound" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFFFF" HorizontalAlignment="Center" />
                    <TextBlock Text="Flanger &amp; Sparkle Shimmer" FontSize="11" Foreground="#99FFFFFF" HorizontalAlignment="Center" Margin="0,4,0,0" />
                  </StackPanel>
                </Border>
                <Border Margin="6" Padding="16,12" CornerRadius="12" Cursor="Hand" BorderThickness="1.5">
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type Border}">
                      <Setter Property="Background" Value="#1AFFFFFF" />
                      <Setter Property="BorderBrush" Value="#22FFFFFF" />
                      <Style.Triggers>
                        <DataTrigger Value="5" Binding="{Binding CurrentSoundEffect}">
                          <Setter Property="Background" Value="#333B82F6" />
                          <Setter Property="BorderBrush" Value="#FF3B82F6" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                  <UIElement.InputBindings>
                    <MouseBinding MouseAction="LeftClick" CommandParameter="5" Command="{Binding ToggleSoundEffectCommand}" />
                  </UIElement.InputBindings>
                  <StackPanel IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Live Treble" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFFFF" HorizontalAlignment="Center" />
                    <TextBlock Text="High shelf boost" FontSize="11" Foreground="#99FFFFFF" HorizontalAlignment="Center" Margin="0,4,0,0" />
                  </StackPanel>
                </Border>
              </UniformGrid>

              <!-- Acoustic Enhancements (Decoupled from EQ) -->
              <Border Height="1" Background="#26FFFFFF" Margin="0,12,0,14" />
              <TextBlock Text="ACOUSTIC ENHANCEMENTS" FontSize="12" FontWeight="SemiBold" Foreground="#B3FFFFFF" Margin="6,0,0,10" />

              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Margin="4" Padding="12" Background="#14FFFFFF" CornerRadius="10" BorderBrush="#1FFFFFFF" BorderThickness="1">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                      <TextBlock Text="Bass Boost" Style="{StaticResource APK_TextBodyStyle}" FontWeight="SemiBold" />
                      <CheckBox HorizontalAlignment="Right" IsChecked="{Binding BassBoostEnabled, Mode=TwoWay}" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="1" Style="{StaticResource APK_SeekSlider}" Height="14" Cursor="Hand" Value="{Binding BassBoostStrength, Mode=TwoWay}" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Margin="4" Padding="12" Background="#14FFFFFF" CornerRadius="10" BorderBrush="#1FFFFFFF" BorderThickness="1">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                      <TextBlock Text="3D Virtualizer" Style="{StaticResource APK_TextBodyStyle}" FontWeight="SemiBold" />
                      <CheckBox HorizontalAlignment="Right" IsChecked="{Binding VirtualizerEnabled, Mode=TwoWay}" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="1" Style="{StaticResource APK_SeekSlider}" Height="14" Cursor="Hand" Value="{Binding VirtualizerStrength, Mode=TwoWay}" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Margin="4" Padding="12" Background="#14FFFFFF" CornerRadius="10" BorderBrush="#1FFFFFFF" BorderThickness="1">
                  <StackPanel>
                    <TextBlock Text="L/R Balance" Style="{StaticResource APK_TextBodyStyle}" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Grid>
                      <Border Width="2" Height="10" Background="#40FFFFFF" CornerRadius="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                      <Slider Minimum="-1" Maximum="1" Style="{StaticResource APK_SeekSlider}" Height="14" Cursor="Hand" Value="{Binding Balance, Mode=TwoWay}" />
                    </Grid>
                  </StackPanel>
                </Border>
              </Grid>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Margin="4" Padding="12" Background="#14FFFFFF" CornerRadius="10" BorderBrush="#1FFFFFFF" BorderThickness="1">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                      <TextBlock Text="Reverb" Style="{StaticResource APK_TextBodyStyle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <CheckBox Content="Enable" Margin="8,0,0,0" VerticalAlignment="Center" IsChecked="{Binding ReverbEnabled, Mode=TwoWay}" />
                      <ComboBox Width="130" HorizontalAlignment="Right" SelectedIndex="{Binding ReverbPreset, Mode=TwoWay}">
                        <ComboBoxItem Content="None" />
                        <ComboBoxItem Content="Small Room" />
                        <ComboBoxItem Content="Medium Room" />
                        <ComboBoxItem Content="Large Room" />
                        <ComboBoxItem Content="Medium Hall" />
                        <ComboBoxItem Content="Large Hall" />
                        <ComboBoxItem Content="Plate" />
                      </ComboBox>
                    </DockPanel>
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Margin="4" Padding="12" Background="#14FFFFFF" CornerRadius="10" BorderBrush="#1FFFFFFF" BorderThickness="1">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                      <TextBlock Text="Loudness" Style="{StaticResource APK_TextBodyStyle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <TextBlock Style="{StaticResource APK_TextLowStyle}" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding LoudnessGain, StringFormat={}{0:+0;-0;0} dB}" />
                      <CheckBox HorizontalAlignment="Right" IsChecked="{Binding LoudnessEnabled, Mode=TwoWay}" />
                    </DockPanel>
                    <Grid>
                      <Border Width="2" Height="10" Background="#40FFFFFF" CornerRadius="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                      <Slider Minimum="-12" Maximum="12" Style="{StaticResource APK_SeekSlider}" Height="14" Cursor="Hand" Value="{Binding LoudnessGain, Mode=TwoWay}" />
                    </Grid>
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
          </Border>
        </Grid>
        <!-- UP NEXT / QUEUE CENTER MODAL -->
        <Grid x:Name="QueueDrawerOverlay" Row="0" RowSpan="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed">
          <Border x:Name="QueueDrawerBackdrop" Background="#99000000" Opacity="0" MouseLeftButtonDown="CloseModal_Click" />
          <Border x:Name="QueueDrawerPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                  MaxWidth="460" MaxHeight="640" Margin="20"
                  Background="#F214171E" BorderBrush="#33FFFFFF" BorderThickness="1"
                  CornerRadius="20" RenderTransformOrigin="0.5,0.5"
                  SnapsToDevicePixels="True" UseLayoutRounding="True" Opacity="0">
            <Border.RenderTransform>
              <ScaleTransform x:Name="QueueDrawerScale" ScaleX="0.88" ScaleY="0.88" />
            </Border.RenderTransform>
            <Border.Effect>
              <DropShadowEffect BlurRadius="32" ShadowDepth="0" Color="#000000" Opacity="0.80" RenderingBias="Performance" />
            </Border.Effect>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <!-- Header -->
              <Border Grid.Row="0" Padding="18,16,14,14" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Text="UP NEXT" FontSize="16" FontWeight="Bold" Foreground="{StaticResource APK_AccentBrush}" FontFamily="Segoe UI" VerticalAlignment="Center" />
                      <Border Background="#1F3B82F6" CornerRadius="10" Margin="10,0,0,0" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding QueueSummaryText}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource APK_AccentBrush}" />
                      </Border>
                    </StackPanel>
                    <TextBlock Text="Drag tracks to reorder • Swipe right to remove" FontSize="11" Foreground="#66FFFFFF" Margin="0,4,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource APK_IconButton}" Width="32" Height="32" ToolTip="Jump to currently playing track" Margin="0,0,4,0" Command="{Binding ScrollToCurrentTrackCommand}">
                      <Path Data="{StaticResource Icon.Visualizer}" Fill="#B3FFFFFF" Stretch="Uniform" Width="14" Height="14" />
                    </Button>
                    <Button Style="{StaticResource APK_IconButton}" Width="32" Height="32" ToolTip="Save as Playlist" Margin="0,0,4,0" Command="{Binding SaveQueueAsPlaylistCommand}">
                      <Path Data="{StaticResource Icon.Playlist}" Fill="#B3FFFFFF" Stretch="Uniform" Width="15" Height="15" />
                    </Button>
                    <Button Style="{StaticResource APK_IconButton}" Width="32" Height="32" ToolTip="Clear Upcoming Tracks" Margin="0,0,6,0" Command="{Binding ClearUpcomingQueueCommand}">
                      <Path Data="{StaticResource Icon.Delete}" Fill="#FFFF5A5A" Stretch="Uniform" Width="14" Height="14" />
                    </Button>
                    <Button Style="{StaticResource APK_IconButton}" Width="32" Height="32" ToolTip="Close" Click="CloseModal_Click">
                      <Path Data="{StaticResource Icon.Close}" Fill="#99FFFFFF" Stretch="Uniform" Width="12" Height="12" />
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>

              <!-- Quick Search Filter in Queue -->
              <Border Grid.Row="1" Padding="16,10,16,6">
                <Border Height="34" CornerRadius="17" Background="#1AFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="10,0">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="20" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="20" />
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Data="{StaticResource Icon.Search}" Fill="#66FFFFFF" Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding QueueFilterText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="#FFFFFFFF" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0" CaretBrush="{StaticResource APK_AccentBrush}" VerticalContentAlignment="Center" />
                    <Button Grid.Column="2" Style="{StaticResource APK_IconButton}" Width="18" Height="18" Visibility="{Binding QueueFilterText, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" Click="ClearQueueFilter_Click" ToolTip="Clear Filter">
                      <Path Data="{StaticResource Icon.Close}" Fill="#66FFFFFF" Stretch="Uniform" Width="8" Height="8" />
                    </Button>
                  </Grid>
                </Border>
              </Border>

              <!-- Now Playing Hero Card -->
              <Border Grid.Row="2" Margin="14,6,14,10" CornerRadius="12" Background="#143B82F6" BorderBrush="#263B82F6" BorderThickness="1" Padding="12,10" Visibility="{Binding CurrentTrack, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <!-- Album Art with Glow -->
                  <Border Grid.Column="0" Width="48" Height="48" CornerRadius="8" ClipToBounds="True" Background="#33FFFFFF" VerticalAlignment="Center">
                    <Image Stretch="UniformToFill" Style="{StaticResource RoundedImage8}" Source="{Binding CurrentTrack, Converter={StaticResource AlbumArtConverter}, ConverterParameter=medium}" />
                  </Border>
                  <!-- Info -->
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Path Data="{StaticResource Icon.Equalizer}" Fill="{StaticResource APK_AccentBrush}" Stretch="Uniform" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,5,0" />
                      <TextBlock Text="NOW PLAYING" FontSize="10" FontWeight="Bold" Foreground="{StaticResource APK_AccentBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding CurrentTrack.Title}" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFFFF" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding CurrentTrack.Artist}" FontSize="11" Foreground="#99FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                  </StackPanel>
                  <!-- Quick Play/Pause on Hero -->
                  <Button Grid.Column="2" Style="{StaticResource APK_IconButton}" Width="36" Height="36" Background="#263B82F6" BorderBrush="#403B82F6" BorderThickness="1" Command="{Binding PlayPauseCommand}" ToolTip="Play / Pause" VerticalAlignment="Center">
                    <Path Stretch="Uniform" Width="12" Height="12" Fill="#FFFFFFFF">
                      <Path.Style>
                        <Style TargetType="Path">
                          <Setter Property="Data" Value="{StaticResource Icon.Play}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                              <Setter Property="Data" Value="{StaticResource Icon.Pause}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Path.Style>
                    </Path>
                  </Button>
                </Grid>
              </Border>

              <!-- Upcoming Tracks List -->
              <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Margin="18,2,18,6">
                  <Grid>
                    <TextBlock Text="UPCOMING" FontSize="11" FontWeight="Bold" Foreground="#66FFFFFF" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Queue.Count, StringFormat='{}{0} tracks'}" FontSize="11" Foreground="#44FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center" />
                  </Grid>
                </Border>

                <Grid Grid.Row="1" ClipToBounds="True">
                  <!-- Empty State -->
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40" Visibility="{Binding Queue.Count, Converter={StaticResource ZeroToVisibilityConverter}}">
                    <Path Data="{StaticResource Icon.Queue}" Fill="#20FFFFFF" Stretch="Uniform" Width="48" Height="48" HorizontalAlignment="Center" />
                    <TextBlock Text="Queue is empty" FontSize="15" FontWeight="SemiBold" Foreground="#66FFFFFF" HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock Text="Play a song or right-click to 'Play Next'" FontSize="12" Foreground="#40FFFFFF" HorizontalAlignment="Center" Margin="0,4,0,0" />
                  </StackPanel>

                  <!-- Virtualized Queue ListBox -->
                  <ListBox x:Name="QueueListBox" Style="{StaticResource APK_VirtualListBox}" ItemsSource="{Binding Queue}" Padding="10,0,10,12" AllowDrop="True" DragOver="QueueListBox_DragOver" Drop="QueueListBox_Drop" PreviewMouseMove="QueueListBox_PreviewMouseMove" PreviewKeyDown="QueueListBox_PreviewKeyDown" VirtualizingStackPanel.CleanUpVirtualizedItem="QueueListBox_CleanUpVirtualizedItem" FocusVisualStyle="{x:Null}" IsTabStop="False" SelectionMode="Single">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border x:Name="QueueItemBorder" Height="56" CornerRadius="10" Margin="0,2" Padding="6,4" Cursor="Hand" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="0"
                                PreviewMouseLeftButtonDown="QueueItem_PreviewMouseLeftButtonDown"
                                MouseMove="QueueItem_MouseMove"
                                MouseLeftButtonUp="QueueItem_MouseLeftButtonUp"
                                LostMouseCapture="QueueItem_LostMouseCapture"
                                DataContextChanged="QueueItem_DataContextChanged">
                          <Border.RenderTransform>
                            <TranslateTransform x:Name="QueueItemTranslate" X="0" />
                          </Border.RenderTransform>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="20" />
                              <ColumnDefinition Width="44" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Grip icon -->
                            <Path Grid.Column="0" Data="{StaticResource Icon.Menu}" Fill="#33FFFFFF" Stretch="Uniform" Width="10" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />

                            <!-- Album Art -->
                            <Border Grid.Column="1" Width="40" Height="40" CornerRadius="6" ClipToBounds="True" Background="#26FFFFFF" VerticalAlignment="Center">
                              <Image Stretch="UniformToFill" Style="{StaticResource RoundedImage6}" Source="{Binding Converter={StaticResource AlbumArtConverter}}" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>

                            <!-- Text info -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,8,0">
                              <TextBlock Style="{StaticResource APK_TextBodyStyle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="150" Text="{Binding Title}" />
                              <TextBlock Style="{StaticResource APK_TextMediumStyle}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="150" Text="{Binding Artist}" />
                            </StackPanel>

                            <!-- Right Controls: Duration, Playing EQ & Action Buttons -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0">
                              <Path x:Name="QueueEqIcon" Data="{StaticResource Icon.Equalizer}" Fill="{StaticResource APK_AccentBrush}" Stretch="Uniform" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed" />
                              <TextBlock Text="{Binding Duration, Converter={StaticResource DurationConverter}}" FontSize="11" Foreground="#66FFFFFF" VerticalAlignment="Center" Margin="0,0,6,0" />
                              <Button x:Name="QueueBtnPlay" Style="{StaticResource APK_IconButton}" Width="26" Height="26" ToolTip="Play Now" Command="{Binding DataContext.PlayQueueTrackCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                <Path Data="{StaticResource Icon.Play}" Fill="#99FFFFFF" Stretch="Uniform" Width="9" Height="9" />
                              </Button>
                              <Button x:Name="QueueBtnRemove" Style="{StaticResource APK_IconButton}" Width="26" Height="26" ToolTip="Remove from Queue" Command="{Binding DataContext.RemoveFromQueueCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="2,0,0,0">
                                <Path Data="{StaticResource Icon.Close}" Fill="#77FFFFFF" Stretch="Uniform" Width="9" Height="9" />
                              </Button>
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ListBox>

                  <Canvas x:Name="QueueDragCanvas" IsHitTestVisible="False" ClipToBounds="True" />
                </Grid>
              </Grid>
            </Grid>
          </Border>
        </Grid>
        <Grid Name="DrawerOverlay" Row="0" RowSpan="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed">
          <Border Name="DrawerBackdrop" Background="#99000000" Opacity="0" MouseLeftButtonDown="DrawerBackdrop_Click" />
          <Border Name="DrawerPanel" HorizontalAlignment="Left" Width="300" Background="#FF1E2128" BorderBrush="#26FFFFFF" BorderThickness="0,0,1,0" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True" UseLayoutRounding="True">
            <UIElement.RenderTransform>
              <TranslateTransform X="-300" />
            </UIElement.RenderTransform>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="80" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Border Grid.Row="0" Padding="0">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF15181F" Offset="0" />
                    <GradientStop Color="#FF1E2A35" Offset="0.5" />
                    <GradientStop Color="#FF15181F" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,0">
                  <TextBlock Text="Music Player" FontSize="26" FontWeight="Light" Foreground="#FFFFFFFF" FontFamily="Segoe UI" FontStyle="Italic" HorizontalAlignment="Center" />
                  <TextBlock Text="Windows Edition" FontSize="11" Foreground="#66FFFFFF" Margin="0,4,0,0" HorizontalAlignment="Center" />
                </StackPanel>
              </Border>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,8">
                  <Button Style="{StaticResource APK_IconButton}" Height="52" HorizontalContentAlignment="Left" Command="{Binding ShowEqualizerPanelCommand}">
                    <StackPanel Orientation="Horizontal" Margin="24,0">
                      <Path Data="{StaticResource Icon.Equalizer}" Fill="#FFFFFFFF" Stretch="Uniform" Width="22" Height="22" Margin="0,0,20,0" VerticalAlignment="Center" />
                      <TextBlock Text="Equalizer" Foreground="#FFFFFFFF" FontSize="14.5" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource APK_IconButton}" Height="52" HorizontalContentAlignment="Left" Command="{Binding ShowSoundEffectsPanelCommand}">
                    <StackPanel Orientation="Horizontal" Margin="24,0">
                      <Path Data="{StaticResource Icon.SoundEffects}" Fill="#FFFFFFFF" Stretch="Uniform" Width="22" Height="22" Margin="0,0,20,0" VerticalAlignment="Center" />
                      <TextBlock Text="Repeat Current" Foreground="#FFFFFFFF" FontSize="14.5" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource APK_IconButton}" Height="52" HorizontalContentAlignment="Left" Command="{Binding OpenThemeGalleryCommand}">
                    <StackPanel Orientation="Horizontal" Margin="24,0">
                      <Path Data="{StaticResource Icon.Theme}" Fill="#FFFFFFFF" Stretch="Uniform" Width="22" Height="22" Margin="0,0,20,0" VerticalAlignment="Center" />
                      <TextBlock Text="Themes" Foreground="#FFFFFFFF" FontSize="14.5" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource APK_IconButton}" Height="52" HorizontalContentAlignment="Left" Command="{Binding OpenSleepTimerCommand}">
                    <StackPanel Orientation="Horizontal" Margin="24,0">
                      <Path Data="{StaticResource Icon.Sleep}" Fill="#FFFFFFFF" Stretch="Uniform" Width="22" Height="22" Margin="0,0,20,0" VerticalAlignment="Center" />
                      <TextBlock Text="Sleep Timer" Foreground="#FFFFFFFF" FontSize="14.5" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource APK_IconButton}" Height="52" HorizontalContentAlignment="Left" Command="{Binding OpenHiddenFilesCommand}">
                    <StackPanel Orientation="Horizontal" Margin="24,0">
                      <Path Data="{StaticResource Icon.Folder}" Fill="#FFFFFFFF" Stretch="Uniform" Width="22" Height="22" Margin="0,0,20,0" VerticalAlignment="Center" />
                      <TextBlock Text="Hidden Files" Foreground="#FFFFFFFF" FontSize="14.5" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource APK_IconButton}" Height="52" HorizontalContentAlignment="Left" Command="{Binding ShowSettingsPanelCommand}">
                    <StackPanel Orientation="Horizontal" Margin="24,0">
                      <Path Data="{StaticResource Icon.Settings}" Fill="#FFFFFFFF" Stretch="Uniform" Width="22" Height="22" Margin="0,0,20,0" VerticalAlignment="Center" />
                      <TextBlock Text="Settings" Foreground="#FFFFFFFF" FontSize="14.5" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </ScrollViewer>
              <Border Grid.Row="2" BorderBrush="#18FFFFFF" BorderThickness="0,1,0,0" Padding="16,8" SnapsToDevicePixels="True" UseLayoutRounding="True">
                <Button Style="{StaticResource APK_IconButton}" Height="48" HorizontalContentAlignment="Left" Click="Close_Click">
                  <StackPanel Orientation="Horizontal" Margin="24,0">
                    <Path Data="{StaticResource Icon.Close}" Fill="#FFFF5A5A" Stretch="Uniform" Width="20" Height="20" Margin="0,0,20,0" VerticalAlignment="Center" />
                    <TextBlock Text="Exit App" FontSize="14" FontWeight="SemiBold" Foreground="#FFFF5A5A" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </Border>
            </Grid>
