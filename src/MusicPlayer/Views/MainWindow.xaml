                      <Button Style="{StaticResource APK_IconButton}" Width="40" Height="40" ToolTip="Equalizer" Command="{Binding ShowEqualizerPanelCommand}">
                        <Path Data="{StaticResource Icon.Equalizer}" Fill="#FFFFFFFF" Stretch="Uniform" Width="20" Height="20" />
