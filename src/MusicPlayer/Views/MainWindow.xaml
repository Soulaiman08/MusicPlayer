                    <StackPanel HorizontalAlignment="Center">
                      <Path Data="{StaticResource Icon.Artwork}" Fill="#FFFFFFFF" Stretch="Uniform" Width="28" Height="28" HorizontalAlignment="Center" />
                      <TextBlock Text="Artwork" Foreground="#FFB0B3BC" FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,0" />
