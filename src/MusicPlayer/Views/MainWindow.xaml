                      <TextBlock Text="Exit Player" Foreground="#FF9AA3B2" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                    <Border Height="1" Background="#0FFFFFFF" Margin="0,6,0,10" Opacity="0.7" />
                    <Grid Height="36">
                      <TextBlock Text="Play to the end regardless of timer" Foreground="#FFFFFFFF" FontSize="13.5" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,64,0" />
                      <CheckBox VerticalAlignment="Center" HorizontalAlignment="Right" Cursor="Hand" IsChecked="{Binding SleepTimerPlayToEnd, Mode=TwoWay}">
                        <Control.Template>
                          <ControlTemplate TargetType="{x:Type CheckBox}">
                            <Border Name="Track" Width="46" Height="26" CornerRadius="13" Background="#3A3F4A" SnapsToDevicePixels="True" BorderBrush="#1AFFFFFF" BorderThickness="1">
                              <Ellipse Name="Dot" Width="18" Height="18" Fill="#FFFFFFFF" HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Center">
                                <UIElement.Effect>
                                  <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.3" Color="Black" RenderingBias="Performance" />
                                </UIElement.Effect>
                              </Ellipse>
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Border.Background" Value="#FFFFCF4D" />
                                <Setter TargetName="Track" Property="Border.BorderBrush" Value="#FFFFCF4D" />
                                <Setter TargetName="Dot" Property="FrameworkElement.HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Dot" Property="FrameworkElement.Margin" Value="0,0,3,0" />
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Control.Template>
