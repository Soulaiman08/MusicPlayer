                    <Button Name="FpLyricsTextBtn" Grid.Column="1" Style="{StaticResource APK_IconButton}" Width="36" Height="36" ToolTip="Lyrics Text Size" Opacity="0" IsHitTestVisible="False" Click="FpLyricsTextBtn_Click">
