                </DataTrigger>
                <DataTrigger Value="Visible" Binding="{Binding ElementName=LoadingOverlay, Path=Visibility}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
          <UIElement.RenderTransform>
            <TranslateTransform x:Name="StatusBarTranslate" X="0" />
          </UIElement.RenderTransform>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Animated loading pulsing dots -->
            <StackPanel Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="{Binding IsStatusBarLoading, Converter={StaticResource BoolToVisibilityConverter}}">
              <Ellipse Name="StatusDot1" Width="6" Height="6" Fill="#FFFFCF4D" Margin="2,0">
                <Ellipse.Triggers>
                  <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                      <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                          <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.2" />
                          <LinearDoubleKeyFrame KeyTime="0:0:0.4" Value="1" />
                          <LinearDoubleKeyFrame KeyTime="0:0:0.8" Value="0.2" />
                        </DoubleAnimationUsingKeyFrames>
                      </Storyboard>
                    </BeginStoryboard>
                  </EventTrigger>
                </Ellipse.Triggers>
              </Ellipse>
              <Ellipse Name="StatusDot2" Width="6" Height="6" Fill="#FFFFCF4D" Margin="2,0">
                <Ellipse.Triggers>
                  <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                      <Storyboard RepeatBehavior="Forever" BeginTime="0:0:0.25">
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                          <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.2" />
                          <LinearDoubleKeyFrame KeyTime="0:0:0.4" Value="1" />
                          <LinearDoubleKeyFrame KeyTime="0:0:0.8" Value="0.2" />
                        </DoubleAnimationUsingKeyFrames>
                      </Storyboard>
                    </BeginStoryboard>
                  </EventTrigger>
                </Ellipse.Triggers>
              </Ellipse>
              <Ellipse Name="StatusDot3" Width="6" Height="6" Fill="#FFFFCF4D" Margin="2,0">
                <Ellipse.Triggers>
                  <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                      <Storyboard RepeatBehavior="Forever" BeginTime="0:0:0.5">
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                          <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.2" />
                          <LinearDoubleKeyFrame KeyTime="0:0:0.4" Value="1" />
                          <LinearDoubleKeyFrame KeyTime="0:0:0.8" Value="0.2" />
                        </DoubleAnimationUsingKeyFrames>
                      </Storyboard>
                    </BeginStoryboard>
                  </EventTrigger>
                </Ellipse.Triggers>
              </Ellipse>
            </StackPanel>
            <Border Width="20" Height="20" CornerRadius="10" Background="#FFFFCF4D" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="{Binding IsStatusBarHiddenLinkVisible, Converter={StaticResource BoolToVisibilityConverter}}">
              <Path Data="{StaticResource Icon.Check}" Fill="#FF2E333E" Stretch="Uniform" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Foreground="#FFFFFFFF" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding StatusBarMessage}" />
            <TextBlock Text="Hidden files." Foreground="#FFFFCF4D" FontSize="13" FontWeight="Bold" TextDecorations="Underline" Cursor="Hand" Margin="4,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsStatusBarHiddenLinkVisible, Converter={StaticResource BoolToVisibilityConverter}}">
              <UIElement.InputBindings>
                <MouseBinding Gesture="LeftClick" Command="{Binding OpenHiddenFilesCommand}" />
              </UIElement.InputBindings>
            </TextBlock>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
