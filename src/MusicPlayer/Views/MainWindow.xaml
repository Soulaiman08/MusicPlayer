              </ListBox>
            </ScrollViewer>
            <ScrollViewer Grid.Row="2" Padding="24,0,24,16" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" CanContentScroll="True">
              <ItemsControl ItemsSource="{Binding LrcLocalFiles}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizingPanel.ScrollUnit="Pixel" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Height="40" Background="#1AFFFFFF" CornerRadius="6" Margin="0,2" Padding="8" Cursor="Hand" MouseLeftButtonUp="LrcFile_Click">
                      <TextBlock Style="{StaticResource APK_TextBodyStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding}" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
          <Grid Visibility="{Binding CurrentView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=lrc_editor}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Padding="16,16,24,8">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource APK_IconButton}" Width="36" Height="36" Command="{Binding GoBackCommand}">
                  <Path Data="{StaticResource Icon.Back}" Fill="#FFFFFFFF" Stretch="Uniform" Width="16" Height="16" />
                </Button>
                <TextBlock Grid.Column="1" Text="EDIT LYRICS" Style="{StaticResource APK_TextSectionTitle}" VerticalAlignment="Center" />
                <Button Grid.Column="2" Style="{StaticResource APK_AccentButton}" Content="Save" Padding="16,6" Command="{Binding SaveLrcEditCommand}" />
              </Grid>
            </Border>
            <Border Grid.Row="1" Margin="16,4" Background="#1AFFFFFF" CornerRadius="8" Padding="2">
              <TextBox AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="14" Foreground="#FFFFFFFF" Background="#00FFFFFF" BorderThickness="0" Padding="12,8" CaretBrush="#FFFFFFFF" Text="{Binding LrcEditText, UpdateSourceTrigger=PropertyChanged}" />
            </Border>
            <TextBlock Grid.Row="2" Text="Write the lyrics of the song" HorizontalAlignment="Center" Margin="0,8,0,16" FontSize="15" FontWeight="SemiBold" Foreground="#FFF0C040" Visibility="{Binding LrcEditShowValidation, Converter={StaticResource BoolToVisibilityConverter}}" />
          </Grid>
          <Grid Visibility="{Binding CurrentView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=lyric_list}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Padding="16,16,24,8">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource APK_IconButton}" Width="36" Height="36" Command="{Binding GoBackCommand}">
                  <Path Data="{StaticResource Icon.Back}" Fill="#FFFFFFFF" Stretch="Uniform" Width="16" Height="16" />
                </Button>
                <TextBlock Grid.Column="1" Text="LYRIC MANAGEMENT" Style="{StaticResource APK_TextSectionTitle}" VerticalAlignment="Center" />
                <Button Grid.Column="2" Style="{StaticResource APK_AccentButton}" Content="Bind to Current" Padding="12,4" Command="{Binding BindLyricFileCommand}" CommandParameter="{Binding SelectedItem, ElementName=LyricListBox}" />
              </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" Padding="24,0,24,16">
              <ItemsControl Name="LyricListBox" ItemsSource="{Binding LrcLocalFiles}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizingPanel.ScrollUnit="Pixel" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Height="40" Background="#1AFFFFFF" CornerRadius="6" Margin="0,2" Padding="8">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource APK_TextBodyStyle}" VerticalAlignment="Center" Text="{Binding}" />
                        <Button Grid.Column="1" Style="{StaticResource APK_IconButton}" Width="32" Height="28" Command="{Binding DataContext.BindLyricFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                          <Path Data="{StaticResource Icon.Plus}" Fill="{StaticResource APK_AccentBrush}" Stretch="Uniform" Width="12" Height="12" />
                        </Button>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
          <Grid Visibility="{Binding CurrentView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=status_bar_lyrics}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Padding="16,16,24,8">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource APK_IconButton}" Width="36" Height="36" Command="{Binding GoBackCommand}">
                  <Path Data="{StaticResource Icon.Back}" Fill="#FFFFFFFF" Stretch="Uniform" Width="16" Height="16" />
                </Button>
                <TextBlock Grid.Column="1" Text="STATUS BAR LYRICS" Style="{StaticResource APK_TextSectionTitle}" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <StackPanel Grid.Row="1" Margin="24,16" MaxWidth="600" HorizontalAlignment="Left">
              <DockPanel Margin="0,6">
                <TextBlock Text="Enable status bar lyrics (Window Title)" Style="{StaticResource APK_TextBodyStyle}" VerticalAlignment="Center" />
                <CheckBox HorizontalAlignment="Right" IsChecked="{Binding IsStatusBarLyricsEnabled}" />
              </DockPanel>
              <TextBlock Text="Windows equivalent: shows current lyric in window title when enabled" Style="{StaticResource APK_TextLowStyle}" Margin="0,8,0,0" />
              <Border Background="#1AFFFFFF" CornerRadius="8" Padding="16" Margin="0,16">
                <TextBlock Style="{StaticResource APK_TextBodyStyle}" FontSize="16" HorizontalAlignment="Center" Text="{Binding CurrentLyricText, FallbackValue=No lyric playing}" />
              </Border>
            </StackPanel>
          </Grid>
          <Grid Visibility="{Binding CurrentView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=theme}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Padding="20,16,20,8">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource APK_IconButton}" Width="36" Height="36" Command="{Binding GoBackCommand}">
                  <Path Data="{StaticResource Icon.Back}" Fill="#FFFFFFFF" Stretch="Uniform" Width="16" Height="16" />
                </Button>
                <TextBlock Grid.Column="1" Text="Themes" Style="{StaticResource APK_TextSectionTitle}" VerticalAlignment="Center" Margin="12,0,0,0" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                  <Border Width="22" Height="22" CornerRadius="11" Background="#F5C026" BorderBrush="#99FFFFFF" BorderThickness="1.5" Margin="0,0,10,0" ToolTip="Current Accent Color" Cursor="Hand" />
                  <Button Style="{StaticResource APK_IconButton}" Width="38" Height="38" Command="{Binding OpenThemeEditorCommand}" ToolTip="Custom Wallpaper &amp; Theme Editor">
                    <Path Data="{StaticResource Icon.ThemeEdit}" Fill="#FFFFFFFF" Stretch="Uniform" Width="20" Height="20" />
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="20,0,20,10">
              <ItemsControl ItemsSource="{Binding WallpaperCategories}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Name="catBorder" Padding="14,6" Margin="0,0,8,0" Cursor="Hand" CornerRadius="16" Background="#26FFFFFF" Tag="{Binding}" MouseLeftButtonUp="WallpaperCategory_Click">
                      <TextBlock Foreground="#FFFFFFFF" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding}" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <ScrollViewer Grid.Row="2" Padding="20,6,20,16" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding FilteredWallpapers}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <local:ThemeWrapPanel MinCardWidth="200" MaxCardWidth="265" Gap="12" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border CornerRadius="8" Cursor="Hand" ClipToBounds="True" Tag="{Binding}" MouseLeftButtonUp="WallpaperItem_Click" Background="#1AFFFFFF">
                      <Grid ClipToBounds="True">
                        <Image Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" RenderOptions.BitmapScalingMode="Linear" Source="{Binding ThumbnailSource}" />
                        <Border Background="#20000000" />
                        <Border Name="checkMark" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Width="24" Height="24" CornerRadius="12" Background="#80000000" Visibility="Collapsed">
                          <Path Data="{StaticResource Icon.Check}" Fill="#FFFFFFFF" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                      </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                      <DataTrigger Value="True" Binding="{Binding IsSelected}">
                        <Setter TargetName="checkMark" Property="UIElement.Visibility" Value="Visible" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
          <Grid Visibility="{Binding CurrentView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=theme_edit}">
            <Grid.Resources>
              <!-- Gold APK Seekbar Slider Style -->
              <Style x:Key="GoldSliderStyle" TargetType="Slider">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                      <Grid VerticalAlignment="Center" Height="28" Background="Transparent">
                        <Track x:Name="PART_Track" VerticalAlignment="Center" Orientation="Horizontal">
                          <Track.DecreaseRepeatButton>
                            <RepeatButton Command="Slider.DecreaseLarge" Cursor="Hand">
                              <RepeatButton.Template>
                                <ControlTemplate TargetType="RepeatButton">
                                  <Border Background="#F5C026" CornerRadius="1.5" Height="3" VerticalAlignment="Center" SnapsToDevicePixels="True" />
                                </ControlTemplate>
                              </RepeatButton.Template>
                            </RepeatButton>
                          </Track.DecreaseRepeatButton>
                          <Track.IncreaseRepeatButton>
                            <RepeatButton Command="Slider.IncreaseLarge" Cursor="Hand">
                              <RepeatButton.Template>
                                <ControlTemplate TargetType="RepeatButton">
                                  <Border Background="#33FFFFFF" CornerRadius="1.5" Height="3" VerticalAlignment="Center" SnapsToDevicePixels="True" />
                                </ControlTemplate>
                              </RepeatButton.Template>
                            </RepeatButton>
                          </Track.IncreaseRepeatButton>
                          <Track.Thumb>
                            <Thumb Cursor="Hand" VerticalAlignment="Center">
                              <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                  <Grid Width="22" Height="22" Background="Transparent" VerticalAlignment="Center">
                                    <Ellipse Width="16" Height="16" Fill="#F5C026" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True">
                                      <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Color="#000000" Opacity="0.4" RenderingBias="Performance" />
                                      </Ellipse.Effect>
                                    </Ellipse>
                                  </Grid>
                                </ControlTemplate>
                              </Thumb.Template>
                            </Thumb>
                          </Track.Thumb>
                        </Track>
                      </Grid>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>

              <!-- Pill Button Style -->
              <Style x:Key="PillButtonStyle" TargetType="Button">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="btnBorder" CornerRadius="18" Background="#1FFFFFFF" BorderBrush="#E6FFFFFF" BorderThickness="1.5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="btnBorder" Property="Background" Value="#33FFFFFF" />
                          <Setter TargetName="btnBorder" Property="BorderBrush" Value="#FFFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                          <Setter TargetName="btnBorder" Property="Background" Value="#4DFFFFFF" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </Grid.Resources>

            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" Padding="16,12,16,12" Background="#26000000" BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Close / Cancel Button -->
                <Button Grid.Column="0" Style="{StaticResource APK_IconButton}" Width="40" Height="40" Command="{Binding CancelThemeEditCommand}" ToolTip="Cancel">
                  <Path Data="{StaticResource Icon.Close}" Fill="#FFFFFFFF" Stretch="Uniform" Width="16" Height="16" />
                </Button>

                <!-- Right Action Buttons: Restore/Reset and Save/Confirm -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Style="{StaticResource APK_IconButton}" Width="40" Height="40" Margin="0,0,12,0" Command="{Binding ResetThemeEditCommand}" ToolTip="Reset Default">
                    <Path Data="{StaticResource Icon.Refresh}" Fill="#FFFFFFFF" Stretch="Uniform" Width="20" Height="20" />
                  </Button>
                  <Button Style="{StaticResource APK_IconButton}" Width="40" Height="40" Command="{Binding SaveThemeEditCommand}" ToolTip="Save &amp; Apply Theme">
                    <Path Data="{StaticResource Icon.Check}" Fill="#FFFFFFFF" Stretch="Uniform" Width="20" Height="20" />
                  </Button>
                </StackPanel>
              </Grid>
            </Border>

            <!-- Content Area with Live Windows MusicPlayer Preview & Sliders -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,10,20,20">
              <StackPanel HorizontalAlignment="Center" Width="700">

                <!-- Windows MusicPlayer Desktop Landscape Preview (16:9) -->
                <Border Width="672" Height="378" CornerRadius="10" Background="#FF15181F" BorderBrush="#33FFFFFF" BorderThickness="1.5" ClipToBounds="True" Margin="0,4,0,14">
                  <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.55" RenderingBias="Performance" />
                  </Border.Effect>
                  <Grid ClipToBounds="True">
                    <!-- Layer 1: Wallpaper Image with Live Blur -->
                    <Image Source="{Binding ThemeEditWallpaperPath}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Image.Effect>
                        <BlurEffect Radius="{Binding ThemeEditBlur}" RenderingBias="Performance" />
                      </Image.Effect>
                    </Image>

                    <!-- Layer 2: Live Black Tint Overlay Controlled by Alpha -->
                    <Border Background="#FF000000" Opacity="{Binding ThemeEditAlphaOpacity}" />

                    <!-- Layer 3: Application Gradient Overlay for depth matching MainWindow -->
                    <Border IsHitTestVisible="False">
                      <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                          <GradientStop Color="#4D15181F" Offset="0" />
                          <GradientStop Color="#33181B24" Offset="0.5" />
                          <GradientStop Color="#59111318" Offset="1" />
                        </LinearGradientBrush>
                      </Border.Background>
                    </Border>

                    <!-- Layer 4: Simulated Windows MusicPlayer UI (Contained, Lightweight Visual Only) -->
                    <Grid IsHitTestVisible="False">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="52" />
                      </Grid.RowDefinitions>

                      <!-- Row 0: Windows MusicPlayer Header Bar -->
                      <Border Grid.Row="0" Background="#40000000" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1" Padding="12,0,12,0">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>

                          <!-- Left: Menu Icon + App Title -->
                          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource Icon.Menu}" Fill="#FFFFFFFF" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center" />
                            <TextBlock Text="Music Player" Foreground="#FFFFFFFF" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" />
                          </StackPanel>

                          <!-- Center: Simulated Search Box -->
                          <Border Grid.Column="1" HorizontalAlignment="Center" Width="200" Height="24" CornerRadius="12" Background="#1FFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="8,0">
                            <Grid VerticalAlignment="Center">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <Path Grid.Column="0" Data="{StaticResource Icon.Search}" Fill="#80FFFFFF" Stretch="Uniform" Width="11" Height="11" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="1" Text="Search music..." Foreground="#66FFFFFF" FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </Grid>
                          </Border>

                          <!-- Right: Action Icons + Window Controls hint -->
                          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource Icon.Equalizer}" Fill="#99FFFFFF" Stretch="Uniform" Width="12" Height="12" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <Path Data="{StaticResource Icon.ThemeEdit}" Fill="#99FFFFFF" Stretch="Uniform" Width="12" Height="12" Margin="0,0,14,0" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Opacity="0.5" VerticalAlignment="Center">
                              <Border Width="9" Height="1.5" Background="#FFFFFF" Margin="0,0,7,0" VerticalAlignment="Center" />
                              <Border Width="8" Height="8" BorderBrush="#FFFFFF" BorderThickness="1" Margin="0,0,7,0" VerticalAlignment="Center" />
                              <Path Data="{StaticResource Icon.Close}" Fill="#FFFFFF" Stretch="Uniform" Width="7.5" Height="7.5" VerticalAlignment="Center" />
                            </StackPanel>
                          </StackPanel>
                        </Grid>
                      </Border>

                      <!-- Row 1: Content Area (Desktop Cards & Playlists) -->
                      <Grid Grid.Row="1" Margin="14,10,14,8">
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 6 Desktop Section Cards (3 columns x 2 rows) -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="52" />
                            <RowDefinition Height="52" />
                          </Grid.RowDefinitions>

                          <!-- 1: ALL SONGS -->
                          <Border Grid.Row="0" Grid.Column="0" Background="#26FFFFFF" CornerRadius="8" Margin="0,0,6,6" Padding="10,6">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#334995F3">
                                <Path Data="{StaticResource Icon.Songs}" Fill="#4995F3" Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Border>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock Text="ALL SONGS" Foreground="#FFFFFFFF" FontSize="9.5" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding HomeCards[0].Count, StringFormat={}{0} tracks, FallbackValue=240 tracks}" Foreground="#99FFFFFF" FontSize="8" Margin="0,2,0,0" />
                              </StackPanel>
                            </Grid>
                          </Border>

                          <!-- 2: FOLDERS -->
                          <Border Grid.Row="0" Grid.Column="1" Background="#26FFFFFF" CornerRadius="8" Margin="0,0,6,6" Padding="10,6">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#33FFCF4D">
                                <Path Data="{StaticResource Icon.Folder}" Fill="#FFCF4D" Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Border>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock Text="FOLDERS" Foreground="#FFFFFFFF" FontSize="9.5" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding HomeCards[1].Count, StringFormat={}{0} folders, FallbackValue=12 folders}" Foreground="#99FFFFFF" FontSize="8" Margin="0,2,0,0" />
                              </StackPanel>
                            </Grid>
                          </Border>

                          <!-- 3: FAVORITES -->
                          <Border Grid.Row="0" Grid.Column="2" Background="#26FFFFFF" CornerRadius="8" Margin="0,0,0,6" Padding="10,6">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#33FF5A5A">
                                <Path Data="{StaticResource Icon.FavoriteFilled}" Fill="#FFFF5A5A" Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Border>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock Text="FAVORITES" Foreground="#FFFFFFFF" FontSize="9.5" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding HomeCards[2].Count, StringFormat={}{0} favorites, FallbackValue=18 favorites}" Foreground="#99FFFFFF" FontSize="8" Margin="0,2,0,0" />
                              </StackPanel>
                            </Grid>
                          </Border>

                          <!-- 4: RECENT PLAYER -->
                          <Border Grid.Row="1" Grid.Column="0" Background="#26FFFFFF" CornerRadius="8" Margin="0,0,6,0" Padding="10,6">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#334CAF50">
                                <Path Data="{StaticResource Icon.Recent}" Fill="#FF66BB6A" Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Border>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock Text="RECENT PLAYER" Foreground="#FFFFFFFF" FontSize="9.5" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding HomeCards[3].Count, StringFormat={}{0} tracks, FallbackValue=45 tracks}" Foreground="#99FFFFFF" FontSize="8" Margin="0,2,0,0" />
                              </StackPanel>
                            </Grid>
                          </Border>

                          <!-- 5: RECENT ADD -->
                          <Border Grid.Row="1" Grid.Column="1" Background="#26FFFFFF" CornerRadius="8" Margin="0,0,6,0" Padding="10,6">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#332196F3">
                                <Path Data="{StaticResource Icon.RecentAdd}" Fill="#FF42A5F5" Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Border>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock Text="RECENT ADD" Foreground="#FFFFFFFF" FontSize="9.5" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding HomeCards[4].Count, StringFormat={}{0} tracks, FallbackValue=30 tracks}" Foreground="#99FFFFFF" FontSize="8" Margin="0,2,0,0" />
                              </StackPanel>
                            </Grid>
                          </Border>

                          <!-- 6: MOST PLAY -->
                          <Border Grid.Row="1" Grid.Column="2" Background="#26FFFFFF" CornerRadius="8" Margin="0,0,0,0" Padding="10,6">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#33FF9800">
                                <Path Data="{StaticResource Icon.MostPlayed}" Fill="#FFFFB74D" Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
