                            <Path Data="{StaticResource Icon.Plus}" Fill="#B3FFFFFF" Stretch="Uniform" Width="9" Height="9" Margin="0,0,4,0" />
                            <TextBlock Text="New Playlist" Foreground="#B3FFFFFF" FontSize="8.5" VerticalAlignment="Center" />
                          </StackPanel>
                        </Grid>

                        <!-- Playlists Row -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                          <!-- Playlist Tile 1 -->
                          <Border Width="136" Height="42" Background="#1EFFFFFF" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6" Background="#334995F3">
                                <Path Data="{StaticResource Icon.Playlist}" Fill="#4995F3" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Border>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                <TextBlock Text="Favorites" Foreground="#FFFFFFFF" FontSize="8.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="18 tracks" Foreground="#80FFFFFF" FontSize="7.5" Margin="0,1,0,0" />
                              </StackPanel>
                            </Grid>
                          </Border>

                          <!-- Playlist Tile 2 -->
                          <Border Width="136" Height="42" Background="#1EFFFFFF" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6" Background="#33FFCF4D">
                                <Path Data="{StaticResource Icon.Playlist}" Fill="#FFCF4D" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Border>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                <TextBlock Text="Chill Vibes" Foreground="#FFFFFFFF" FontSize="8.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="24 tracks" Foreground="#80FFFFFF" FontSize="7.5" Margin="0,1,0,0" />
                              </StackPanel>
                            </Grid>
                          </Border>

                          <!-- Playlist Tile 3 -->
                          <Border Width="136" Height="42" Background="#1EFFFFFF" CornerRadius="6" Padding="8,4">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6" Background="#334CAF50">
                                <Path Data="{StaticResource Icon.Playlist}" Fill="#FF66BB6A" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Border>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                <TextBlock Text="Driving Hits" Foreground="#FFFFFFFF" FontSize="8.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="36 tracks" Foreground="#80FFFFFF" FontSize="7.5" Margin="0,1,0,0" />
                              </StackPanel>
                            </Grid>
                          </Border>
                        </StackPanel>
                      </Grid>

                      <!-- Row 2: Docked Windows MusicPlayer Mini Player (mirrors real layout) -->
                      <Border Grid.Row="2" Background="#FF181B22" BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0">
                        <Grid>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                          </Grid.ColumnDefinitions>

                          <!-- Left: Square Album Art + Track/Artist info (mimics real left column) -->
                          <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" ClipToBounds="True">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <!-- Square album art (same height as mini player) -->
                              <Border Grid.Column="0" Width="52" Height="52" ClipToBounds="True" Background="#26FFFFFF">
                                <Image Stretch="UniformToFill" Source="{Binding CurrentTrack, Converter={StaticResource AlbumArtConverter}, ConverterParameter=medium}" />
                              </Border>
                              <!-- Track title + artist -->
                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,8,0">
                                <TextBlock Text="{Binding CurrentTrack.Title, FallbackValue='No track playing'}" Foreground="#FFFFFFFF" FontSize="9" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding CurrentTrack.Artist, FallbackValue='Unknown Artist'}" Foreground="#80FFFFFF" FontSize="7.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                              </StackPanel>
                            </Grid>
                          </Border>

                          <!-- Center Row 0: Playback controls (mirrors real: SoundFX, Fav, Prev, CirclePlay, Next, Repeat, EQ) -->
                          <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="{StaticResource Icon.SoundEffects}" Fill="#FFFFFFFF" Stretch="Uniform" Width="9" Height="9" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <Path Data="{StaticResource Icon.Favorite}" Fill="#FFFFFFFF" Stretch="Uniform" Width="9" Height="9" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <Path Data="{StaticResource Icon.Previous}" Fill="#FFFFFFFF" Stretch="Uniform" Width="10" Height="10" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <!-- Circle Play Button -->
                            <Border Width="18" Height="18" CornerRadius="9" Background="#F5C026" Margin="0,0,5,0">
                              <Path Data="{StaticResource Icon.Play}" Fill="#FF000000" Stretch="Uniform" Width="8" Height="8" Margin="1,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Path Data="{StaticResource Icon.Next}" Fill="#FFFFFFFF" Stretch="Uniform" Width="10" Height="10" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <Path Data="{StaticResource Icon.Repeat}" Fill="#66FFFFFF" Stretch="Uniform" Width="9" Height="9" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <Path Data="{StaticResource Icon.Equalizer}" Fill="#FFFFFFFF" Stretch="Uniform" Width="9" Height="9" VerticalAlignment="Center" />
                          </StackPanel>

                          <!-- Center Row 1: Progress bar with time stamps (mirrors real seekbar row) -->
                          <Grid Grid.Column="1" Grid.Row="1" Margin="0,0,0,6">
                            <Grid HorizontalAlignment="Center" Width="180">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <TextBlock Grid.Column="0" Text="{Binding Position, Converter={StaticResource DurationConverter}, FallbackValue='0:00'}" Foreground="#99FFFFFF" FontSize="7" VerticalAlignment="Center" />
                              <!-- Seekbar track -->
                              <Border Grid.Column="1" Height="3" CornerRadius="1.5" Background="#26FFFFFF" Margin="4,0">
                                <!-- Progress fill at ~35% -->
                                <Border HorizontalAlignment="Left" Width="60" Background="#F5C026" CornerRadius="1.5" />
                              </Border>
                              <TextBlock Grid.Column="2" Text="{Binding Duration, Converter={StaticResource DurationConverter}, FallbackValue='0:00'}" Foreground="#99FFFFFF" FontSize="7" VerticalAlignment="Center" />
                            </Grid>
                          </Grid>

                          <!-- Right: Queue, Playlist, Speed, EQ icons (mirrors real right column) -->
                          <StackPanel Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Path Data="{StaticResource Icon.Queue}" Fill="#FFFFFFFF" Stretch="Uniform" Width="10" Height="10" Margin="0,0,7,0" />
                            <Path Data="{StaticResource Icon.Playlist}" Fill="#FFFFFFFF" Stretch="Uniform" Width="10" Height="10" Margin="0,0,7,0" />
                            <Path Data="{StaticResource Icon.SpeedPitch}" Fill="#FFFFFFFF" Stretch="Uniform" Width="10" Height="10" Margin="0,0,7,0" />
                            <Path Data="{StaticResource Icon.Equalizer}" Fill="#FFFFFFFF" Stretch="Uniform" Width="10" Height="10" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </Grid>
                  </Grid>
                </Border>

                <!-- Change Picture Button (Pill Button) -->
                <Button HorizontalAlignment="Center" Style="{StaticResource PillButtonStyle}" Command="{Binding ChooseThemePictureCommand}" Margin="0,6,0,14" Padding="28,7">
                  <TextBlock Text="Change picture" Foreground="#FFFFFFFF" FontSize="13.5" FontWeight="SemiBold" />
                </Button>

                <!-- Sliders Section -->
                <Grid HorizontalAlignment="Center" Width="520" Margin="0,0,0,10">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="38" />
                    <RowDefinition Height="38" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="65" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <!-- Alpha Slider -->
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Alpha" Foreground="#FFFFFFFF" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <Slider Grid.Row="0" Grid.Column="1" Style="{StaticResource GoldSliderStyle}" Minimum="0" Maximum="255" Value="{Binding ThemeEditAlpha, Mode=TwoWay}" />

                  <!-- Blur Slider -->
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Blur" Foreground="#FFFFFFFF" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <Slider Grid.Row="1" Grid.Column="1" Style="{StaticResource GoldSliderStyle}" Minimum="0" Maximum="50" Value="{Binding ThemeEditBlur, Mode=TwoWay}" />
                </Grid>

              </StackPanel>
            </ScrollViewer>
          </Grid>
          <Grid x:Name="SleepTimerGrid" Opacity="0" Visibility="{Binding CurrentView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=sleep_timer}" IsVisibleChanged="SleepTimerGrid_IsVisibleChanged" RenderOptions.BitmapScalingMode="HighQuality">
            <UIElement.RenderTransform>
              <TranslateTransform Y="14" />
            </UIElement.RenderTransform>
            <FrameworkElement.Triggers>
              <EventTrigger RoutedEvent="Grid.Loaded">
                <BeginStoryboard>
                  <Storyboard DesiredFrameRate="60">
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22">
                      <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="14" To="0" Duration="0:0:0.26">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
            </FrameworkElement.Triggers>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Padding="20,18,24,14" Background="#0AFFFFFF">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource APK_IconButton}" Width="36" Height="36" Command="{Binding GoBackCommand}">
                  <Path Data="{StaticResource Icon.Back}" Fill="#FFFFFFFF" Stretch="Uniform" Width="18" Height="18" />
                </Button>
                <TextBlock Grid.Column="1" Text="Sleep timer" FontSize="18" FontWeight="Bold" Foreground="#FFFFFFFF" VerticalAlignment="Center" Margin="12,0,0,0" />
              </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,0,20">
              <StackPanel Margin="24,16" HorizontalAlignment="Stretch">
                <Border Background="#FF2E333E" CornerRadius="14" Padding="0,8" BorderBrush="#14FFFFFF" BorderThickness="1">
                  <UIElement.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.15" Color="Black" RenderingBias="Performance" />
                  </UIElement.Effect>
                  <StackPanel>
                    <Button Style="{StaticResource APK_RowButton}" Background="#00FFFFFF" BorderThickness="0" Padding="16,0" Height="48" Cursor="Hand" CommandParameter="0" HorizontalContentAlignment="Stretch" Command="{Binding SetSleepTimerCommand}">
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                          <Grid Background="#00FFFFFF" Height="48">
                            <TextBlock Text="Close sleep mode" Foreground="#FFFFFFFF" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="22,0,0,0" />
                            <Border Name="RadioOuter" Width="22" Height="22" CornerRadius="11" BorderThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,22,0" BorderBrush="#4DFFFFFF" Background="#00FFFFFF">
                              <Ellipse Name="RadioDot" Width="12" Height="12" Fill="#FFFFCF4D" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                          </Grid>
                          <ControlTemplate.Triggers>
                            <DataTrigger Value="0" Binding="{Binding SleepTimerPresetMinutes}">
                              <Setter TargetName="RadioOuter" Property="Border.BorderBrush" Value="#FFFFCF4D" />
                              <Setter TargetName="RadioDot" Property="UIElement.Visibility" Value="Visible" />
                            </DataTrigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Control.Template>
                    </Button>
                    <Border Height="1" Background="#0FFFFFFF" Margin="22,0" Opacity="0.7" />
                    <Button Style="{StaticResource APK_RowButton}" Background="#00FFFFFF" BorderThickness="0" Padding="16,0" Height="48" Cursor="Hand" CommandParameter="10" HorizontalContentAlignment="Stretch" Command="{Binding SetSleepTimerCommand}">
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                          <Grid Background="#00FFFFFF" Height="48">
                            <TextBlock Text="10 mins" Foreground="#FFFFFFFF" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="22,0,0,0" />
                            <Border Name="RadioOuter" Width="22" Height="22" CornerRadius="11" BorderThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,22,0" BorderBrush="#4DFFFFFF">
                              <Ellipse Name="RadioDot" Width="12" Height="12" Fill="#FFFFCF4D" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                          </Grid>
                          <ControlTemplate.Triggers>
                            <DataTrigger Value="10" Binding="{Binding SleepTimerPresetMinutes}">
                              <Setter TargetName="RadioOuter" Property="Border.BorderBrush" Value="#FFFFCF4D" />
                              <Setter TargetName="RadioDot" Property="UIElement.Visibility" Value="Visible" />
                            </DataTrigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Control.Template>
                    </Button>
                    <Border Height="1" Background="#0FFFFFFF" Margin="22,0" Opacity="0.7" />
                    <Button Style="{StaticResource APK_RowButton}" Background="#00FFFFFF" BorderThickness="0" Padding="16,0" Height="48" Cursor="Hand" CommandParameter="20" HorizontalContentAlignment="Stretch" Command="{Binding SetSleepTimerCommand}">
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                          <Grid Background="#00FFFFFF" Height="48">
                            <TextBlock Text="20 mins" Foreground="#FFFFFFFF" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="22,0,0,0" />
                            <Border Name="RadioOuter" Width="22" Height="22" CornerRadius="11" BorderThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,22,0" BorderBrush="#4DFFFFFF">
                              <Ellipse Name="RadioDot" Width="12" Height="12" Fill="#FFFFCF4D" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                          </Grid>
                          <ControlTemplate.Triggers>
                            <DataTrigger Value="20" Binding="{Binding SleepTimerPresetMinutes}">
                              <Setter TargetName="RadioOuter" Property="Border.BorderBrush" Value="#FFFFCF4D" />
                              <Setter TargetName="RadioDot" Property="UIElement.Visibility" Value="Visible" />
                            </DataTrigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Control.Template>
                    </Button>
                    <Border Height="1" Background="#0FFFFFFF" Margin="22,0" Opacity="0.7" />
                    <Button Style="{StaticResource APK_RowButton}" Background="#00FFFFFF" BorderThickness="0" Padding="16,0" Height="48" Cursor="Hand" CommandParameter="30" HorizontalContentAlignment="Stretch" Command="{Binding SetSleepTimerCommand}">
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                          <Grid Background="#00FFFFFF" Height="48">
                            <TextBlock Text="30 mins" Foreground="#FFFFFFFF" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="22,0,0,0" />
                            <Border Name="RadioOuter" Width="22" Height="22" CornerRadius="11" BorderThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,22,0" BorderBrush="#4DFFFFFF">
                              <Ellipse Name="RadioDot" Width="12" Height="12" Fill="#FFFFCF4D" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                          </Grid>
                          <ControlTemplate.Triggers>
                            <DataTrigger Value="30" Binding="{Binding SleepTimerPresetMinutes}">
                              <Setter TargetName="RadioOuter" Property="Border.BorderBrush" Value="#FFFFCF4D" />
                              <Setter TargetName="RadioDot" Property="UIElement.Visibility" Value="Visible" />
                            </DataTrigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Control.Template>
                    </Button>
                    <Border Height="1" Background="#0FFFFFFF" Margin="22,0" Opacity="0.7" />
                    <Button Style="{StaticResource APK_RowButton}" Background="#00FFFFFF" BorderThickness="0" Padding="16,0" Height="48" Cursor="Hand" CommandParameter="60" HorizontalContentAlignment="Stretch" Command="{Binding SetSleepTimerCommand}">
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                          <Grid Background="#00FFFFFF" Height="48">
                            <TextBlock Text="60 mins" Foreground="#FFFFFFFF" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="22,0,0,0" />
                            <Border Name="RadioOuter" Width="22" Height="22" CornerRadius="11" BorderThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,22,0" BorderBrush="#4DFFFFFF">
                              <Ellipse Name="RadioDot" Width="12" Height="12" Fill="#FFFFCF4D" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                          </Grid>
                          <ControlTemplate.Triggers>
                            <DataTrigger Value="60" Binding="{Binding SleepTimerPresetMinutes}">
                              <Setter TargetName="RadioOuter" Property="Border.BorderBrush" Value="#FFFFCF4D" />
                              <Setter TargetName="RadioDot" Property="UIElement.Visibility" Value="Visible" />
                            </DataTrigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Control.Template>
                    </Button>
                    <Border Height="1" Background="#0FFFFFFF" Margin="22,0" Opacity="0.7" />
                    <Button Style="{StaticResource APK_RowButton}" Background="#00FFFFFF" BorderThickness="0" Padding="16,0" Height="48" Cursor="Hand" CommandParameter="90" HorizontalContentAlignment="Stretch" Command="{Binding SetSleepTimerCommand}">
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                          <Grid Background="#00FFFFFF" Height="48">
                            <TextBlock Text="90 mins" Foreground="#FFFFFFFF" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="22,0,0,0" />
                            <Border Name="RadioOuter" Width="22" Height="22" CornerRadius="11" BorderThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,22,0" BorderBrush="#4DFFFFFF">
                              <Ellipse Name="RadioDot" Width="12" Height="12" Fill="#FFFFCF4D" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                          </Grid>
                          <ControlTemplate.Triggers>
                            <DataTrigger Value="90" Binding="{Binding SleepTimerPresetMinutes}">
                              <Setter TargetName="RadioOuter" Property="Border.BorderBrush" Value="#FFFFCF4D" />
                              <Setter TargetName="RadioDot" Property="UIElement.Visibility" Value="Visible" />
                            </DataTrigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Control.Template>
                    </Button>
                    <Border Height="1" Background="#0FFFFFFF" Margin="22,0" Opacity="0.7" />
                    <Grid Height="48" Background="#00FFFFFF">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Manual input" Foreground="#FFFFFFFF" FontSize="14" VerticalAlignment="Center" Margin="22,0,12,0" />
                      <Border Grid.Column="1" BorderBrush="#66FFFFFF" BorderThickness="0,0,0,1" VerticalAlignment="Center" Padding="0,2">
                        <TextBox Width="44" Background="#00FFFFFF" Foreground="#FFFFFFFF" BorderThickness="0" FontSize="14" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" MaxLength="3" Text="{Binding SleepTimerManualMinutes, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="SleepTimerManual_PreviewTextInput" KeyDown="SleepTimerManual_KeyDown" />
                      </Border>
                      <TextBlock Grid.Column="2" Text="mins" Foreground="#FFFFFFFF" FontSize="14" VerticalAlignment="Center" Margin="8,0,0,0" />
                      <Button Style="{StaticResource APK_IconButton}" Grid.Column="3" Background="#00FFFFFF" BorderThickness="0" Width="66" Height="48" Cursor="Hand" CommandParameter="manual" HorizontalAlignment="Right" Margin="0" Command="{Binding SetSleepTimerCommand}">
                        <Control.Template>
                          <ControlTemplate TargetType="{x:Type Button}">
                            <Grid Width="66" Height="48">
                              <Border Name="RadioOuter" Width="22" Height="22" CornerRadius="11" BorderThickness="1.5" BorderBrush="#4DFFFFFF" Background="#00FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,22,0">
                                <Ellipse Name="RadioDot" Width="12" Height="12" Fill="#FFFFCF4D" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                              <DataTrigger Value="True" Binding="{Binding IsManualSleepTimerActive}">
                                <Setter TargetName="RadioOuter" Property="Border.BorderBrush" Value="#FFFFCF4D" />
                                <Setter TargetName="RadioDot" Property="UIElement.Visibility" Value="Visible" />
                              </DataTrigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Control.Template>
                      </Button>
                    </Grid>
                  </StackPanel>
                </Border>
                <Border Background="#FF2E333E" CornerRadius="14" Padding="18,14" Margin="0,18,0,0" BorderBrush="#14FFFFFF" BorderThickness="1">
