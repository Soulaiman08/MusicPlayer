<Window x:Class="MusicPlayer.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:MusicPlayer.Views" xmlns:vm="clr-namespace:MusicPlayer.ViewModels" xmlns:conv="clr-namespace:MusicPlayer.Converters" Title="Music Player" Icon="/Assets/app_logo.png" Width="1280" Height="720" MinWidth="1024" MinHeight="650" WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow" ResizeMode="CanResize" Background="#FF15181F" SnapsToDevicePixels="True" UseLayoutRounding="True" AllowDrop="True" ShowInTaskbar="True" PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseLeftButtonDown="Window_PreviewMouseLeftDown" Drop="Window_Drop" DragOver="Window_DragOver" Closing="Window_Closing">
  <Border Name="RootBorder" Background="#FF15181F" ClipToBounds="True">
    <Grid>
      <Image Name="BackgroundImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
      <Border Background="#FF000000" Opacity="{Binding WallpaperAlphaOpacity}" />
      <Border IsHitTestVisible="False">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4D15181F" Offset="0" />
            <GradientStop Color="#33181B24" Offset="0.5" />
            <GradientStop Color="#59111318" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="56" />
          <RowDefinition Height="*" />
          <RowDefinition Height="90" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#40000000" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1" SnapsToDevicePixels="True" UseLayoutRounding="True">
          <Grid Margin="12,0,12,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Style="{StaticResource APK_IconButton}" Width="40" Height="40" ToolTip="Menu" Command="{Binding ToggleDrawerCommand}">
                <Path Data="{StaticResource Icon.Menu}" Fill="#FFFFFFFF" Stretch="Uniform" Width="20" Height="20" />
              </Button>
              <TextBlock Text="Music Player" Style="{StaticResource APK_TextAppTitle}" Margin="8,0,24,0" />
            </StackPanel>
          </Grid>
        </Border>
        <Grid Name="ContentGrid" Row="1" Visibility="Collapsed">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,16,24,16" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" CanContentScroll="True" Visibility="{Binding CurrentView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=home}">
            <StackPanel>
              <Border Background="#331D2026" CornerRadius="12" Padding="16" Margin="0,0,0,20" Visibility="{Binding SearchQuery, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                <StackPanel>
                  <TextBlock Text="Search Results" Style="{StaticResource APK_TextSectionTitle}" Margin="0,0,0,12" />
                  <!-- Table Header -->
                  <Border Background="#0AFFFFFF" BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1" Height="36" Margin="0,0,0,0">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54" />
                        <ColumnDefinition Width="2.2*" MinWidth="130" />
                        <ColumnDefinition Width="1.4*" MinWidth="100" />
                        <ColumnDefinition Width="65" />
                        <ColumnDefinition Width="40" />
                      </Grid.ColumnDefinitions>
                      <Border Grid.Column="0" BorderBrush="#18FFFFFF" BorderThickness="0,0,1,0">
                        <Path Data="{StaticResource Icon.Album}" Fill="#AAFFFFFF" Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <Border Grid.Column="1" BorderBrush="#18FFFFFF" BorderThickness="0,0,1,0">
                        <TextBlock Text="Title" Foreground="#FFFFFFFF" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="14,0,8,0" />
                      </Border>
                      <Border Grid.Column="2" BorderBrush="#18FFFFFF" BorderThickness="0,0,1,0">
                        <TextBlock Text="Artists" Foreground="#FFFFFFFF" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="14,0,8,0" />
                      </Border>
                      <Border Grid.Column="3">
                        <Path Data="{StaticResource Icon.Recent}" Fill="#70FFFFFF" Stretch="Uniform" Width="13" Height="13" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="Duration" />
                      </Border>
                    </Grid>
                  </Border>
                  <ItemsControl ItemsSource="{Binding SearchResults}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <VirtualizingStackPanel VirtualizingPanel.ScrollUnit="Pixel" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Height="52" BorderThickness="0,0,0,1" BorderBrush="#14FFFFFF" Padding="0" Cursor="Hand" MouseLeftButtonUp="SearchResult_Click" SnapsToDevicePixels="True">
                          <Border.Background>
                            <MultiBinding Converter="{StaticResource PlayingTrackHighlightConverter}">
                              <Binding Path="Id" />
                              <Binding Path="CurrentPlayingTrackId" RelativeSource="{RelativeSource AncestorType=Window}" />
                            </MultiBinding>
                          </Border.Background>
                          <Border.Style>
                            <Style TargetType="Border">
                              <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter Property="Background" Value="#15FFFFFF" />
                                </Trigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="54" />
                              <ColumnDefinition Width="2.2*" MinWidth="130" />
                              <ColumnDefinition Width="1.4*" MinWidth="100" />
                              <ColumnDefinition Width="65" />
                              <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="42" Height="42" CornerRadius="4" ClipToBounds="True" Background="#26FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center">
                              <Image Stretch="UniformToFill" Style="{StaticResource RoundedImage4}" Source="{Binding Converter={StaticResource AlbumArtConverter}}" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <TextBlock Grid.Column="1" Style="{StaticResource APK_TextBodyStyle}" FontWeight="Medium" FontSize="13" VerticalAlignment="Center" Margin="14,0,8,0" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                            <TextBlock Grid.Column="2" Foreground="#D8FFFFFF" FontSize="12.5" VerticalAlignment="Center" Margin="14,0,8,0" TextTrimming="CharacterEllipsis" Text="{Binding Artist, Converter={StaticResource FallbackIfEmptyConverter}, ConverterParameter=Unknown Artist}" />
                            <TextBlock Grid.Column="3" Style="{StaticResource APK_TextLowStyle}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,14,0" Text="{Binding Duration, Converter={StaticResource DurationConverter}}" />
                            <Button Grid.Column="4" Style="{StaticResource APK_IconButton}" Width="32" Height="32" ToolTip="Options" Command="{Binding DataContext.OpenTrackBottomSheetCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                              <Path Data="{StaticResource Icon.More}" Fill="#88FFFFFF" Stretch="Uniform" Width="13" Height="13" />
                            </Button>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="No results found" Style="{StaticResource APK_TextMediumStyle}" HorizontalAlignment="Center" Margin="0,16" Visibility="{Binding SearchResults.Count, Converter={StaticResource ZeroToVisibilityConverter}}" />
                </StackPanel>
              </Border>
              <Grid Margin="0,4,0,24">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Grid.Column="0" Height="100" Margin="0,0,12,12" Background="#26FFFFFF" CornerRadius="12" Cursor="Hand" MouseLeftButtonUp="AllSongsCard_Click">
                  <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="54" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" Background="#334995F3">
                      <Path Data="{StaticResource Icon.Songs}" Fill="{StaticResource APK_AccentBrush}" Stretch="Uniform" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                      <TextBlock Text="ALL SONGS" Style="{StaticResource APK_TextSectionTitle}" FontSize="15" />
                      <TextBlock Style="{StaticResource APK_TextMediumStyle}" Margin="0,3,0,0" Text="{Binding HomeCards[0].Count, StringFormat={}{0} tracks}" />
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Height="100" Margin="0,0,12,12" Background="#26FFFFFF" CornerRadius="12" Cursor="Hand" MouseLeftButtonUp="FoldersCard_Click">
                  <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="54" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" Background="#33FFCF4D">
                      <Path Data="{StaticResource Icon.Folder}" Fill="{StaticResource APK_YellowBrush}" Stretch="Uniform" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                      <TextBlock Text="FOLDERS" Style="{StaticResource APK_TextSectionTitle}" FontSize="15" />
                      <TextBlock Style="{StaticResource APK_TextMediumStyle}" Margin="0,3,0,0" Text="{Binding HomeCards[1].Count, StringFormat={}{0} folders}" />
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Grid.Row="0" Grid.Column="2" Height="100" Margin="0,0,0,12" Background="#26FFFFFF" CornerRadius="12" Cursor="Hand" MouseLeftButtonUp="FavoritesCard_Click">
                  <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="54" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" Background="#33FF5A5A">
                      <Path Data="{StaticResource Icon.FavoriteFilled}" Fill="#FFFF5A5A" Stretch="Uniform" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                      <TextBlock Text="FAVORITES" Style="{StaticResource APK_TextSectionTitle}" FontSize="15" />
                      <TextBlock Style="{StaticResource APK_TextMediumStyle}" Margin="0,3,0,0" Text="{Binding HomeCards[2].Count, StringFormat={}{0} favorites}" />
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Height="100" Margin="0,0,12,0" Background="#26FFFFFF" CornerRadius="12" Cursor="Hand" MouseLeftButtonUp="RecentPlayCard_Click">
                  <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="54" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" Background="#334CAF50">
                      <Path Data="{StaticResource Icon.Recent}" Fill="#FF66BB6A" Stretch="Uniform" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                      <TextBlock Text="RECENT PLAYER" Style="{StaticResource APK_TextSectionTitle}" FontSize="15" />
                      <TextBlock Style="{StaticResource APK_TextMediumStyle}" Margin="0,3,0,0" Text="{Binding HomeCards[3].Count, StringFormat={}{0} tracks}" />
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Height="100" Margin="0,0,12,0" Background="#26FFFFFF" CornerRadius="12" Cursor="Hand" MouseLeftButtonUp="RecentAddCard_Click">
                  <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="54" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" Background="#332196F3">
                      <Path Data="{StaticResource Icon.RecentAdd}" Fill="#FF42A5F5" Stretch="Uniform" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                      <TextBlock Text="RECENT ADD" Style="{StaticResource APK_TextSectionTitle}" FontSize="15" />
                      <TextBlock Style="{StaticResource APK_TextMediumStyle}" Margin="0,3,0,0" Text="{Binding HomeCards[4].Count, StringFormat={}{0} tracks}" />
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Grid.Row="1" Grid.Column="2" Height="100" Margin="0,0,0,0" Background="#26FFFFFF" CornerRadius="12" Cursor="Hand" MouseLeftButtonUp="MostPlayCard_Click">
                  <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="54" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" Background="#33FF9800">
                      <Path Data="{StaticResource Icon.MostPlayed}" Fill="#FFFFB74D" Stretch="Uniform" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                      <TextBlock Text="MOST PLAY" Style="{StaticResource APK_TextSectionTitle}" FontSize="15" />
                      <TextBlock Style="{StaticResource APK_TextMediumStyle}" Margin="0,3,0,0" Text="{Binding HomeCards[5].Count, StringFormat={}{0} tracks}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </Grid>
              <Grid Margin="0,16,0,12">
                <TextBlock Text="PLAYLISTS" Style="{StaticResource APK_TextSectionTitle}" />
                <Button Style="{StaticResource APK_IconButton}" HorizontalAlignment="Right" ToolTip="New Playlist" Click="NewPlaylist_Click">
                  <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.Plus}" Fill="{StaticResource APK_AccentBrush}" Stretch="Uniform" Width="14" Height="14" Margin="0,0,6,0" />
                    <TextBlock Text="New Playlist" Foreground="{StaticResource APK_AccentBrush}" FontSize="13" FontWeight="SemiBold" />
                  </StackPanel>
                </Button>
              </Grid>
              <ItemsControl ItemsSource="{Binding Playlists}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding ActualWidth, Converter={StaticResource ThemeColumnsConverter}, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Width="180" Height="70" Background="#1EFFFFFF" CornerRadius="10" Margin="0,0,12,12" Padding="12" Cursor="Hand" MouseLeftButtonUp="PlaylistItem_Click">
                      <FrameworkElement.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Play" Click="PlaylistContextPlay_Click" />
                          <MenuItem Header="Rename" Click="PlaylistRename_Click" />
                          <MenuItem Header="Delete" Click="PlaylistContextDelete_Click" />
                        </ContextMenu>
                      </FrameworkElement.ContextMenu>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="44" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="#334995F3">
                          <Path Data="{StaticResource Icon.Playlist}" Fill="{StaticResource APK_AccentBrush}" Stretch="Uniform" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                          <TextBlock Style="{StaticResource APK_TextBodyStyle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                          <TextBlock Style="{StaticResource APK_TextLowStyle}" Margin="0,2,0,0" Text="{Binding TrackCount, StringFormat={}{0} songs}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
          <Grid Visibility="{Binding IsTrackListView, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Padding="16,12,20,4">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource APK_IconButton}" Width="36" Height="36" ToolTip="Back" Margin="0,0,8,0" Command="{Binding GoBackCommand}">
                  <Path Data="{StaticResource Icon.Back}" Fill="#FFFFFFFF" Stretch="Uniform" Width="16" Height="16" />
                </Button>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource APK_TextSectionTitle}" VerticalAlignment="Center" Text="{Binding CurrentTrackListTitle}" />
                  <TextBlock Style="{StaticResource APK_TextMediumStyle}" VerticalAlignment="Center" Margin="12,0,0,0" Text="{Binding DisplayedTracks.Count, StringFormat={}{0} tracks}" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource APK_IconButton}" Width="36" Height="36" ToolTip="Search" Margin="0,0,4,0" Command="{Binding ToggleSearchCommand}">
                  <Path Data="{StaticResource Icon.Search}" Fill="#FFFFFFFF" Stretch="Uniform" Width="16" Height="16" />
                </Button>
                <Button Grid.Column="3" Style="{StaticResource APK_IconButton}" Height="32" Padding="8,4" ToolTip="Sort by" Margin="0,0,4,0" Command="{Binding ToggleSortMenuCommand}">
                  <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.Equalizer}" Fill="{StaticResource APK_YellowBrush}" Stretch="Uniform" Width="14" Height="14" Margin="0,0,4,0" />
                    <TextBlock Text="Sort" Foreground="{StaticResource APK_YellowBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="4" Style="{StaticResource APK_IconButton}" Width="36" Height="36" ToolTip="More Options" Command="{Binding ToggleOverflowMenuCommand}">
                  <Path Data="{StaticResource Icon.More}" Fill="#FFFFFFFF" Stretch="Uniform" Width="16" Height="16" />
                </Button>
              </Grid>
            </Border>
            <Border Name="SearchBarBorder" Grid.Row="1" Padding="20,6,20,6" Opacity="0" MaxHeight="0" ClipToBounds="True" Visibility="Collapsed">
              <Border.Background>
                <SolidColorBrush Color="#26FFFFFF" />
              </Border.Background>
              <Border CornerRadius="18" Height="36">
                <Grid Margin="12,0,12,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Path Grid.Column="0" Data="{StaticResource Icon.Search}" Fill="#80FFFFFF" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <TextBox Name="SearchBox" Grid.Column="1" Background="#00FFFFFF" BorderThickness="0" Foreground="#FFFFFFFF" CaretBrush="{StaticResource APK_AccentBrush}" FontSize="13" VerticalAlignment="Center" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                  <Button Grid.Column="2" Style="{StaticResource APK_IconButton}" Width="24" Height="24" Padding="0" Command="{Binding ToggleSearchCommand}">
                    <Path Data="{StaticResource Icon.Close}" Fill="#99FFFFFF" Stretch="Uniform" Width="10" Height="10" />
                  </Button>
                </Grid>
              </Border>
            </Border>
            <Border Grid.Row="2" Padding="20,0,20,4" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1" SnapsToDevicePixels="True" UseLayoutRounding="True">
              <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource APK_IconButton}" Padding="12,8" Margin="0,0,8,0" Click="TabSongs_Click">
                  <StackPanel>
                    <TextBlock Text="TRACKS" FontSize="14" FontWeight="Bold" Foreground="{Binding CurrentTab, Converter={StaticResource EqualityToBrushConverter}, ConverterParameter=songs}" />
                    <Border Height="3" Background="{StaticResource APK_YellowBrush}" Margin="0,4,0,0" Visibility="{Binding CurrentTab, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=songs}" />
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource APK_IconButton}" Padding="12,8" Margin="0,0,8,0" Click="TabArtists_Click">
                  <StackPanel>
                    <TextBlock Text="ARTISTS" FontSize="14" FontWeight="Bold" Foreground="{Binding CurrentTab, Converter={StaticResource EqualityToBrushConverter}, ConverterParameter=artists}" />
                    <Border Height="3" Background="{StaticResource APK_YellowBrush}" Margin="0,4,0,0" Visibility="{Binding CurrentTab, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=artists}" />
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource APK_IconButton}" Padding="12,8" Margin="0,0,8,0" Click="TabAlbums_Click">
                  <StackPanel>
                    <TextBlock Text="ALBUMS" FontSize="14" FontWeight="Bold" Foreground="{Binding CurrentTab, Converter={StaticResource EqualityToBrushConverter}, ConverterParameter=albums}" />
                    <Border Height="3" Background="{StaticResource APK_YellowBrush}" Margin="0,4,0,0" Visibility="{Binding CurrentTab, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=albums}" />
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource APK_IconButton}" Padding="12,8" Margin="0,0,8,0" Click="TabGenres_Click">
                  <StackPanel>
                    <TextBlock Text="GENRES" FontSize="14" FontWeight="Bold" Foreground="{Binding CurrentTab, Converter={StaticResource EqualityToBrushConverter}, ConverterParameter=genres}" />
                    <Border Height="3" Background="{StaticResource APK_YellowBrush}" Margin="0,4,0,0" Visibility="{Binding CurrentTab, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=genres}" />
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource APK_IconButton}" Padding="12,8" Margin="0,0,8,0" Click="TabFolders_Click">
                  <StackPanel>
                    <TextBlock Text="FOLDERS" FontSize="14" FontWeight="Bold" Foreground="{Binding CurrentTab, Converter={StaticResource EqualityToBrushConverter}, ConverterParameter=folders}" />
                    <Border Height="3" Background="{StaticResource APK_YellowBrush}" Margin="0,4,0,0" Visibility="{Binding CurrentTab, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=folders}" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>
            <Grid Row="3" ClipToBounds="True">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasNoMusic, Converter={StaticResource BoolToVisibilityConverter}}">
                <Path Data="{StaticResource Icon.Songs}" Fill="#40FFFFFF" Stretch="Uniform" Width="64" Height="64" Margin="0,0,0,16" />
                <TextBlock Text="No music found" Style="{StaticResource APK_TextSectionTitle}" HorizontalAlignment="Center" Foreground="#99FFFFFF" />
                <TextBlock Text="Click '+' in Folders to add your music" Style="{StaticResource APK_TextMediumStyle}" HorizontalAlignment="Center" Foreground="#66FFFFFF" Margin="0,8,0,0" />
              </StackPanel>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasNoSearchResults, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="No results found" FontSize="16" FontWeight="SemiBold" Foreground="#80FFFFFF" HorizontalAlignment="Center" />
                <TextBlock Text="Try a different keyword" FontSize="13" Foreground="#50FFFFFF" HorizontalAlignment="Center" Margin="0,6,0,0" />
              </StackPanel>
              <Grid Name="TabSlideHost">
                <Grid Name="TabContent_Songs">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <Border Grid.Row="0" Margin="0,4,0,2" BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1" SnapsToDevicePixels="True">
                    <Grid Height="38">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="54" />
                        <ColumnDefinition Width="2.2*" MinWidth="130" />
                        <ColumnDefinition Width="1.4*" MinWidth="110" />
                        <ColumnDefinition Width="1.4*" MinWidth="110" />
                        <ColumnDefinition Width="1.0*" MinWidth="80" />
                        <ColumnDefinition Width="65" />
                        <ColumnDefinition Width="40" />
                      </Grid.ColumnDefinitions>
                      <Border Grid.Column="1" BorderBrush="#18FFFFFF" BorderThickness="0,0,1,0">
                        <Path Data="{StaticResource Icon.Album}" Fill="#AAFFFFFF" Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <Border Grid.Column="2" BorderBrush="#18FFFFFF" BorderThickness="0,0,1,0">
                        <TextBlock Text="Title" Foreground="#FFFFFFFF" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="14,0,8,0" />
                      </Border>
                      <Border Grid.Column="3" BorderBrush="#18FFFFFF" BorderThickness="0,0,1,0">
                        <TextBlock Text="Artists" Foreground="#FFFFFFFF" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="14,0,8,0" />
                      </Border>
                      <Border Grid.Column="4" BorderBrush="#18FFFFFF" BorderThickness="0,0,1,0">
                        <TextBlock Text="Album" Foreground="#FFFFFFFF" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="14,0,8,0" />
