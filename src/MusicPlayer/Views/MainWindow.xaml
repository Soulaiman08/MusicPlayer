                          <Path Data="{StaticResource Icon.Pause}" Fill="#FFFFFFFF" Stretch="Uniform" Width="22" Height="22" Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                      </Button>
                      <Button Style="{StaticResource APK_IconButton}" Width="44" Height="44" ToolTip="Next" Command="{Binding NextCommand}">
