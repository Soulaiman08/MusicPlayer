<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark Theme -->
    <ResourceDictionary x:Key="DarkTheme">
        <Color x:Key="ThemeBackground">#FF1D2026</Color>
        <Color x:Key="ThemeSurface">#FF242831</Color>
        <Color x:Key="ThemeToolbar">#FF16213E</Color>
        <Color x:Key="ThemeAccent">#FF4995F3</Color>
        <Color x:Key="ThemeSelection">#FFFFCF4D</Color>
        <Color x:Key="ThemeTextPrimary">#FFFFFFFF</Color>
        <Color x:Key="ThemeTextMedium">#B3FFFFFF</Color>
        <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="{StaticResource ThemeBackground}"/>
        <SolidColorBrush x:Key="ThemeSurfaceBrush" Color="{StaticResource ThemeSurface}"/>
        <SolidColorBrush x:Key="ThemeToolbarBrush" Color="{StaticResource ThemeToolbar}"/>
        <SolidColorBrush x:Key="ThemeAccentBrush" Color="{StaticResource ThemeAccent}"/>
        <SolidColorBrush x:Key="ThemeSelectionBrush" Color="{StaticResource ThemeSelection}"/>
        <SolidColorBrush x:Key="ThemeTextPrimaryBrush" Color="{StaticResource ThemeTextPrimary}"/>
        <SolidColorBrush x:Key="ThemeTextMediumBrush" Color="{StaticResource ThemeTextMedium}"/>
    </ResourceDictionary>

