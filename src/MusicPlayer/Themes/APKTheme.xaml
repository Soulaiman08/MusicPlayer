        <Setter Property="FontSize" Value="{StaticResource APK_FontSize_Small}"/>
        <Setter Property="Foreground" Value="{StaticResource APK_TextMediumBrush}"/>
    </Style>

    <Style x:Key="APK_TextLowStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource APK_FontPrimary}"/>
        <Setter Property="FontSize" Value="{StaticResource APK_FontSize_Tiny}"/>
        <Setter Property="Foreground" Value="{StaticResource APK_TextLowBrush}"/>
    </Style>

    <!-- ===== DEFAULT ITEMS CONTROL (enables UI virtualization for all lists) ===== -->
    <Style TargetType="ItemsControl">
        <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="VirtualizingPanel.CacheLength" Value="2,2"/>
        <Setter Property="VirtualizingPanel.CacheLengthUnit" Value="Item"/>
    </Style>

    <!-- ===== UP NEXT QUEUE LISTBOX STYLE (own identity, drag-to-reorder) ===== -->
    <!--
        The queue is NOT a track table. It is a drag-to-reorder list: the rows are
        picked up with the mouse, dropped on another row, and the list auto-scrolls
        while a drag is near its edge. That makes its geometry load-bearing - the
        drop indicator, the auto-scroll bounds and the dragged ghost are all
        measured against the list - so it gets its own style instead of sharing
        APK_VirtualListBox with the tables. A change to the table list (padding,
        inset, item container) can therefore never move the queue, and a change
        here can never move the tables.

        It deliberately does NOT inset its content through the list: the rows carry
        their own margin, so the vertical scrollbar stays flush with the edge of
        the queue card instead of floating inside it.
    -->
    <Style x:Key="APK_QueueListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
        <Setter Property="VirtualizingPanel.CacheLength" Value="3,3"/>
        <Setter Property="VirtualizingPanel.CacheLengthUnit" Value="Item"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel
                        VirtualizingStackPanel.IsVirtualizing="True"
                        VirtualizingStackPanel.VirtualizationMode="Recycling"
                        VirtualizingStackPanel.ScrollUnit="Pixel"
                        VirtualizingPanel.CacheLengthUnit="Item"
                        VirtualizingPanel.CacheLength="3,3" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="0"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ItemsHost"
                                      Focusable="False"
                                      Padding="0"
                                      CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                            <ScrollViewer.PanningMode>VerticalOnly</ScrollViewer.PanningMode>
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border Background="Transparent" BorderThickness="0" BorderBrush="Transparent">
                                    <ContentPresenter />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== VIRTUALIZED LISTBOX STYLE (high-performance, instant rendering, recycling) ===== -->
    <Style x:Key="APK_VirtualListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
        <Setter Property="VirtualizingPanel.CacheLength" Value="3,3"/>
        <Setter Property="VirtualizingPanel.CacheLengthUnit" Value="Item"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel
                        VirtualizingStackPanel.IsVirtualizing="True"
                        VirtualizingStackPanel.VirtualizationMode="Recycling"
                        VirtualizingStackPanel.ScrollUnit="Pixel"
                        VirtualizingPanel.CacheLengthUnit="Item"
                        VirtualizingPanel.CacheLength="3,3" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <!--
            WPF's built-in ListBox template puts a hard-coded Padding="1" on its
            inner Border, so every list - and every table built on one - is inset
            one pixel on the left, top and right. That pixel is what stops the
            album artwork from reaching the window edge, and it drags the whole
            row grid one pixel off the header. This template is the same one
            without that inset, so the list content starts exactly at the edge.
        -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="0"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ItemsHost"
                                      Focusable="False"
                                      Padding="{TemplateBinding Padding}"
                                      CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                            <ScrollViewer.PanningMode>VerticalOnly</ScrollViewer.PanningMode>
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border Background="Transparent" BorderThickness="0" BorderBrush="Transparent">
                                    <ContentPresenter/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== BUTTON STYLES ===== -->
    <Style x:Key="APK_IconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="20" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#26FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#40FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tab Button: transparent tab, centered content, subtle hover halo (no Windows default chrome) -->
    <Style x:Key="APK_TabButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#1AFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#26FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Row Button: full-width option rows, halo fitting the row shape -->
    <Style x:Key="APK_RowButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#1AFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#26FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Cell Button: grid-cell icon buttons, rounded halo fitting the cell -->
    <Style x:Key="APK_CellButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="Transparent" CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#1AFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#26FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="APK_AccentButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource APK_AccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource APK_AccentHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource APK_AccentPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="#26FFFFFF"/>
                            <Setter Property="Foreground" Value="#66FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Accent Play / Action Round Button -->
    <Style x:Key="APK_CircleActionButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource APK_AccentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="100">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource APK_AccentHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource APK_AccentPressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Seek Slider Style -->
    <Style x:Key="APK_SeekSlider" TargetType="Slider">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center" Height="14" Background="Transparent" Cursor="Hand">
                        <Track x:Name="PART_Track"
                               VerticalAlignment="Center"
                               Orientation="Horizontal"
                               Value="{TemplateBinding Value}"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Cursor="Hand">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border x:Name="DecreaseBorder" Background="#FF7EC8E3" CornerRadius="1.5" Height="3" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True">
                                                    <Setter TargetName="DecreaseBorder" Property="Height" Value="5"/>
                                                    <Setter TargetName="DecreaseBorder" Property="CornerRadius" Value="2.5"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Cursor="Hand">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border x:Name="IncreaseBorder" Background="#33485B6A" CornerRadius="1.5" Height="3" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True">
                                                    <Setter TargetName="IncreaseBorder" Property="Height" Value="5"/>
                                                    <Setter TargetName="IncreaseBorder" Property="CornerRadius" Value="2.5"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Cursor="Hand" VerticalAlignment="Center">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Width="14" Height="14" Background="Transparent" Cursor="Hand" VerticalAlignment="Center">
                                                <Ellipse x:Name="Halo" Width="20" Height="20" Fill="#337EC8E3" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-3"/>
                                                <Ellipse x:Name="Dot" Width="10" Height="10" Fill="#FF7EC8E3" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Halo" Property="Opacity" Value="0.35"/>
                                                    <Setter TargetName="Halo" Property="Width" Value="20"/>
                                                    <Setter TargetName="Halo" Property="Height" Value="20"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Halo" Property="Opacity" Value="0.55"/>
                                                    <Setter TargetName="Halo" Property="Width" Value="22"/>
                                                    <Setter TargetName="Halo" Property="Height" Value="22"/>
                                                    <Setter TargetName="Dot" Property="Width" Value="11"/>
                                                    <Setter TargetName="Dot" Property="Height" Value="11"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Cursor" Value="Hand"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="APK_SeekSlider_Vertical" TargetType="Slider">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid HorizontalAlignment="Center" Width="24" Background="Transparent" Cursor="Hand">
                        <Track x:Name="PART_Track"
                               HorizontalAlignment="Center"
                               Orientation="Vertical"
                               Value="{TemplateBinding Value}"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Cursor="Hand">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border x:Name="DecreaseBorder" Background="#33485B6A" CornerRadius="2" Width="4" HorizontalAlignment="Center" SnapsToDevicePixels="True"/>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True">
                                                    <Setter TargetName="DecreaseBorder" Property="Background" Value="#4D62778A"/>
                                                    <Setter TargetName="DecreaseBorder" Property="Width" Value="5"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Cursor="Hand">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border x:Name="IncreaseBorder" Background="#33485B6A" CornerRadius="2" Width="4" HorizontalAlignment="Center" SnapsToDevicePixels="True"/>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True">
                                                    <Setter TargetName="IncreaseBorder" Property="Background" Value="#4D62778A"/>
                                                    <Setter TargetName="IncreaseBorder" Property="Width" Value="5"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Cursor="Hand" HorizontalAlignment="Center">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Width="20" Height="20" Background="Transparent" Cursor="Hand" HorizontalAlignment="Center">
                                                <Ellipse x:Name="Halo" Width="22" Height="22" Fill="#337EC8E3" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Ellipse x:Name="Dot" Width="12" Height="12" Fill="#FF7EC8E3" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Halo" Property="Opacity" Value="0.4"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Halo" Property="Opacity" Value="0.6"/>
                                                    <Setter TargetName="Halo" Property="Width" Value="24"/>
                                                    <Setter TargetName="Halo" Property="Height" Value="24"/>
                                                    <Setter TargetName="Dot" Property="Width" Value="13"/>
                                                    <Setter TargetName="Dot" Property="Height" Value="13"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Seek Bar / Progress Bar -->
    <Style x:Key="APK_MiniProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="12"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource APK_AccentBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="TemplateRoot" VerticalAlignment="Center" Height="12">
                        <Border Background="#33FFFFFF" CornerRadius="2" Height="2" VerticalAlignment="Center"/>
                        <Border x:Name="PART_Track" HorizontalAlignment="Stretch"/>
                        <Grid x:Name="PART_Indicator" HorizontalAlignment="Left">
                            <Border Background="{TemplateBinding Foreground}" CornerRadius="2" Height="2" VerticalAlignment="Center"/>
                            <Ellipse Width="8" Height="8" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-4,0"/>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== GLOBAL THIN SCROLLBAR (Android-style, virtualization-safe) ===== -->
    <!-- Track is transparent; only the thin rounded thumb is visible. -->
    <!-- No arrow buttons, no effects, triggers only (software-render safe). -->
    <SolidColorBrush x:Key="APK_ScrollBarTrackBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="APK_ScrollBarThumbBrush" Color="#597E8794"/>
    <SolidColorBrush x:Key="APK_ScrollBarThumbHoverBrush" Color="#997E8794"/>
    <SolidColorBrush x:Key="APK_ScrollBarThumbPressedBrush" Color="#FF7EC8E3"/>

    <!-- Transparent page buttons: keep PageUp/PageDown/Left/Right working, no visuals -->
    <Style x:Key="APK_ScrollPageButton" TargetType="RepeatButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thin vertical thumb: 8px visual pill (radius = half width); pure stretch so Track sizes it without clipping -->
    <Style x:Key="APK_ScrollThumbVertical" TargetType="Thumb">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBar" Background="{StaticResource APK_ScrollBarThumbBrush}" CornerRadius="4" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBar" Property="Background" Value="{StaticResource APK_ScrollBarThumbHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBar" Property="Background" Value="{StaticResource APK_ScrollBarThumbPressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thin horizontal thumb: 8px visual pill (radius = half height); pure stretch so Track sizes it without clipping -->
    <Style x:Key="APK_ScrollThumbHorizontal" TargetType="Thumb">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBar" Background="{StaticResource APK_ScrollBarThumbBrush}" CornerRadius="4" Height="8" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBar" Property="Background" Value="{StaticResource APK_ScrollBarThumbHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBar" Property="Background" Value="{StaticResource APK_ScrollBarThumbPressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="APK_VerticalScrollBarTemplate" TargetType="ScrollBar">
        <Grid Background="{StaticResource APK_ScrollBarTrackBrush}" SnapsToDevicePixels="True">
            <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource APK_ScrollPageButton}"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource APK_ScrollPageButton}"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource APK_ScrollThumbVertical}"/>
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="APK_HorizontalScrollBarTemplate" TargetType="ScrollBar">
        <Grid Background="{StaticResource APK_ScrollBarTrackBrush}" SnapsToDevicePixels="True">
            <Track x:Name="PART_Track" IsDirectionReversed="False" Focusable="False">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource APK_ScrollPageButton}"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource APK_ScrollPageButton}"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource APK_ScrollThumbHorizontal}"/>
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>

    <!-- One implicit global style: every ScrollBar in the app (all lists, queue, lyrics, settings) -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template" Value="{StaticResource APK_VerticalScrollBarTemplate}"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Template" Value="{StaticResource APK_HorizontalScrollBarTemplate}"/>
            </Trigger>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Height" Value="Auto"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Global implicit ScrollViewer style: enforces pixel-based virtualization units -->
    <Style TargetType="ScrollViewer">
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
    </Style>

    <Style TargetType="ListBox" BasedOn="{StaticResource APK_VirtualListBox}"/>

    <!-- ===== DS_ DESIGN TOKENS (additive layer for the UI redesign) =====
         Foundation-only: no existing resource is modified and no template consumes
         these yet. Colors/brushes deliberately mirror the current APK_ palette via
         StaticResource so P2 can restyle a screen with DS_ tokens while the visual
         values stay identical to today's look. Naming: DS_<group>_<role>. -->
    <SolidColorBrush x:Key="DS_Bg_Brush" Color="{StaticResource APK_DarkBackground}"/>
    <SolidColorBrush x:Key="DS_Surface_Brush" Color="{StaticResource APK_DarkSurface}"/>
    <SolidColorBrush x:Key="DS_SurfaceOverlay_Brush" Color="{StaticResource APK_DarkToolbarOverlay}"/>
    <SolidColorBrush x:Key="DS_Divider_Brush" Color="{StaticResource APK_ListDivider}"/>
    <SolidColorBrush x:Key="DS_Accent_Brush" Color="{StaticResource APK_AccentBlue}"/>
    <SolidColorBrush x:Key="DS_Accent_Hover_Brush" Color="{StaticResource APK_AccentBlueHover}"/>
    <SolidColorBrush x:Key="DS_Accent_Pressed_Brush" Color="{StaticResource APK_AccentBluePressed}"/>
    <SolidColorBrush x:Key="DS_Highlight_Brush" Color="{StaticResource APK_SelectionYellow}"/>
    <SolidColorBrush x:Key="DS_Text_Primary_Brush" Color="{StaticResource APK_TextPrimary}"/>
    <SolidColorBrush x:Key="DS_Text_Secondary_Brush" Color="{StaticResource APK_TextMedium}"/>
    <SolidColorBrush x:Key="DS_Text_Tertiary_Brush" Color="{StaticResource APK_TextLow}"/>
    <SolidColorBrush x:Key="DS_Text_Disabled_Brush" Color="{StaticResource APK_TextDisabled}"/>
    <SolidColorBrush x:Key="DS_Card_Brush" Color="{StaticResource APK_CardBackground}"/>
    <SolidColorBrush x:Key="DS_Card_Hover_Brush" Color="{StaticResource APK_CardBackgroundHover}"/>
    <SolidColorBrush x:Key="DS_Card_Border_Brush" Color="{StaticResource APK_CardBorder}"/>
    <SolidColorBrush x:Key="DS_Hover_Subtle_Brush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="DS_Hover_Overlay_Brush" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="DS_Pressed_Overlay_Brush" Color="#40FFFFFF"/>

    <!-- Spacing scale (doubles for Width/Height/Padding; Thickness pair for Margin) -->
    <sys:Double x:Key="DS_Spacing_XS">4</sys:Double>
    <sys:Double x:Key="DS_Spacing_S">8</sys:Double>
    <sys:Double x:Key="DS_Spacing_M">12</sys:Double>
    <sys:Double x:Key="DS_Spacing_L">16</sys:Double>
    <sys:Double x:Key="DS_Spacing_XL">24</sys:Double>
    <sys:Double x:Key="DS_Spacing_XXL">32</sys:Double>
    <Thickness x:Key="DS_Spacing_T_XS">4</Thickness>
    <Thickness x:Key="DS_Spacing_T_S">8</Thickness>
    <Thickness x:Key="DS_Spacing_T_M">12</Thickness>
    <Thickness x:Key="DS_Spacing_T_L">16</Thickness>
    <Thickness x:Key="DS_Spacing_T_XL">24</Thickness>
    <Thickness x:Key="DS_Spacing_T_XXL">32</Thickness>

    <!-- Corner radii -->
    <CornerRadius x:Key="DS_Radius_XS">4</CornerRadius>
    <CornerRadius x:Key="DS_Radius_S">6</CornerRadius>
    <CornerRadius x:Key="DS_Radius_M">12</CornerRadius>
    <CornerRadius x:Key="DS_Radius_L">18</CornerRadius>
    <CornerRadius x:Key="DS_Radius_Round">100</CornerRadius>

    <!-- Typography -->
    <FontFamily x:Key="DS_Font_Family">Segoe UI, Roboto, sans-serif</FontFamily>
    <sys:Double x:Key="DS_FontSize_XS">10</sys:Double>
    <sys:Double x:Key="DS_FontSize_S">12</sys:Double>
    <sys:Double x:Key="DS_FontSize_M">13</sys:Double>
    <sys:Double x:Key="DS_FontSize_L">18</sys:Double>
    <sys:Double x:Key="DS_FontSize_XL">20</sys:Double>
    <sys:Double x:Key="DS_FontSize_Display">28</sys:Double>
    <FontWeight x:Key="DS_FontWeight_Regular">Normal</FontWeight>
    <FontWeight x:Key="DS_FontWeight_Medium">Medium</FontWeight>
    <FontWeight x:Key="DS_FontWeight_SemiBold">SemiBold</FontWeight>
    <FontWeight x:Key="DS_FontWeight_Bold">Bold</FontWeight>

</ResourceDictionary>