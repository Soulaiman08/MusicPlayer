    <Color x:Key="APK_TextHigh">#FFFFFFFF</Color>
    <Color x:Key="APK_TextMedium">#B3FFFFFF</Color>
    <Color x:Key="APK_TextLow">#4DFFFFFF</Color>
    <Color x:Key="APK_TextDisabled">#4D4D4D4D</Color>

    <!-- Card Backgrounds -->
    <Color x:Key="APK_CardBackground">#1F242C38</Color>
    <Color x:Key="APK_CardBackgroundHover">#333A485A</Color>
    <Color x:Key="APK_CardBorder">#1AFFFFFF</Color>

    <!-- ===== BRUSHES ===== -->
    <SolidColorBrush x:Key="APK_BackgroundBrush" Color="{StaticResource APK_DarkBackground}"/>
    <SolidColorBrush x:Key="APK_SurfaceBrush" Color="{StaticResource APK_DarkSurface}"/>
    <SolidColorBrush x:Key="APK_ToolbarOverlayBrush" Color="{StaticResource APK_DarkToolbarOverlay}"/>
    <SolidColorBrush x:Key="APK_ListDividerBrush" Color="{StaticResource APK_ListDivider}"/>
    <SolidColorBrush x:Key="APK_AccentBrush" Color="{StaticResource APK_AccentBlue}"/>
    <SolidColorBrush x:Key="APK_AccentHoverBrush" Color="{StaticResource APK_AccentBlueHover}"/>
    <SolidColorBrush x:Key="APK_AccentPressedBrush" Color="{StaticResource APK_AccentBluePressed}"/>
    <SolidColorBrush x:Key="APK_SelectionBrush" Color="{StaticResource APK_SelectionYellow}"/>
    <SolidColorBrush x:Key="APK_YellowBrush" Color="{StaticResource APK_SelectionYellow}"/>
    <SolidColorBrush x:Key="APK_TextPrimaryBrush" Color="{StaticResource APK_TextPrimary}"/>
    <SolidColorBrush x:Key="APK_TextMediumBrush" Color="{StaticResource APK_TextMedium}"/>
    <SolidColorBrush x:Key="APK_TextLowBrush" Color="{StaticResource APK_TextLow}"/>
